---
import { Picture } from 'astro:assets';
import milkyway from '../assets/contact-milkyway.png';
import Icon from './Icon.astro';
import { contactHref, site } from '../data/site';
---
<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="panel" data-reveal="open">
      <Picture src={milkyway} formats={['avif', 'webp']} widths={[700]} sizes="100vw" alt="" class="sky" />
      <span class="sky-glow" aria-hidden="true">
        <span class="dust"></span>
        <i class="star s1"></i>
        <i class="star s2"></i>
      </span>
      <span class="rim" aria-hidden="true"></span>
      <div class="inner" data-reveal="rise" data-reveal-group>
        <h2 id="contact-title">Want to build something with us?</h2>
        <p>We build software, tools, and product ideas from small problems worth solving.</p>
        <div class="actions">
          <a class="btn btn--primary" href={contactHref} data-umami-event="contact_click" data-umami-event-location="contact">
            <Icon name="mail" />Contact Us
          </a>
          <a class="btn btn--secondary" href="#products" data-umami-event="products_click" data-umami-event-location="contact">See Our Products</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: clamp(48px, 7vw, 96px) clamp(56px, 7vw, 96px);
  }

  .panel {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border-radius: clamp(24px, 3vw, 36px);
    background: #0e1528;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 0 0 1px var(--line);
  }

  .panel :global(picture),
  .panel :global(.sky) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .panel :global(.sky) {
    object-fit: cover;
    /* the Milky Way band cropped from the hero plate (contact-milkyway.png) */
    object-position: 50% 70%;
    opacity: 0.9;
  }

  .panel[data-armed] :global(.sky) {
    transition: transform 1.8s var(--ease-out);
  }

  .panel[data-armed]:not([data-shown]) :global(.sky) {
    transform: scale(1.18);
  }

  .panel::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(70% 90% at 50% 50%, rgb(11 17 30 / 0.55), rgb(11 17 30 / 0.15));
  }

  /* ---------- hover: the same soft galaxy as the product cards ---------- */
  .sky-glow,
  .rim {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }

  .sky-glow {
    overflow: hidden;
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), rgb(150 120 255 / 0.14), rgb(80 150 255 / 0.05) 45%, transparent 72%);
  }

  .rim {
    padding: 1px;
    background: radial-gradient(300px circle at var(--mx, 50%) var(--my, 50%), rgb(185 172 216 / 0.6), rgb(110 140 255 / 0.2) 40%, transparent 70%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
  }

  .panel:hover .sky-glow,
  .panel:hover .rim {
    opacity: 1;
  }

  .dust {
    position: absolute;
    left: 0;
    top: 0;
    width: 1.5px;
    height: 1.5px;
    border-radius: 50%;
    color: var(--dust);
    box-shadow:
      90px 80px 0 0 currentColor, 210px 360px 0 0 #fff, 300px 150px 0 -0.3px currentColor,
      140px 470px 0 0 currentColor, 380px 440px 0 -0.2px #fff, 520px 60px 0 0 currentColor,
      640px 470px 0 -0.3px currentColor, 760px 110px 0 0 #fff, 850px 400px 0 -0.2px currentColor,
      930px 230px 0 0 currentColor, 1010px 90px 0 -0.3px #fff, 1080px 450px 0 0 currentColor,
      60px 260px 0 -0.4px #fff, 1110px 300px 0 -0.4px #fff;
    opacity: 0.6;
    animation: contact-dust 10s ease-in-out infinite;
    animation-play-state: paused;
  }

  .star {
    position: absolute;
    width: 2.5px;
    height: 2.5px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 8px 1px rgb(200 215 255 / 0.8);
    opacity: 0.2;
    animation: contact-star 4.8s ease-in-out infinite;
    animation-play-state: paused;
  }

  .star.s1 { left: 17%; top: 28%; }
  .star.s2 { right: 15%; bottom: 22%; animation-duration: 6.4s; animation-delay: -2.3s; }

  .panel:hover .dust,
  .panel:hover .star {
    animation-play-state: running;
  }

  @keyframes contact-dust {
    0%, 100% { translate: 0 0; opacity: 0.45; }
    50% { translate: 5px -8px; opacity: 0.85; }
  }

  @keyframes contact-star {
    0%, 100% { opacity: 0.15; }
    50% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dust,
    .star {
      animation: none;
      opacity: 0.6;
    }
  }

  .inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 18px;
    padding: clamp(64px, 9vw, 120px) var(--gutter);
    text-align: center;
  }

  h2 {
    max-width: 16ch;
    font-size: clamp(2.25rem, 4.6vw, 3.75rem);
    line-height: 1.02;
    font-weight: 640;
    letter-spacing: -0.04em;
  }

  p {
    max-width: 30rem;
    font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
    color: #c3c8dc;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 14px;
  }
</style>

<script>
  // The hover glow follows the pointer (mouse and pen only).
  const panel = document.querySelector<HTMLElement>('.contact .panel');
  let frame = 0;
  panel?.addEventListener('pointermove', (e) => {
    if (e.pointerType === 'touch') return;
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(() => {
      const r = panel.getBoundingClientRect();
      panel.style.setProperty('--mx', `${e.clientX - r.left}px`);
      panel.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>
