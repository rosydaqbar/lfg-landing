---
import { Image } from 'astro:assets';
import step1 from '../assets/how/step-1.png';
import rocketBg from '../assets/how/step-2-bg.png';
import rocket from '../assets/how/step-2-rocket.png';
import flame from '../assets/how/step-2-flame.png';
import orbitBg from '../assets/how/step-3-bg.png';
import satellite from '../assets/how/step-3-satellite.png';

// Watercolor spot illustrations in the hero's style (generated with Codex, cropped to a shared
// square). Steps 2 and 3 are split into layers (also by Codex) so parts of them can move.
const img = { widths: [340, 480], sizes: '340px', formats: ['avif', 'webp'] as const, loading: 'lazy' as const, decoding: 'async' as const, alt: '' };
const steps = [
  { n: '01', title: 'Find a Real Problem', body: 'Start from something small, clear, and worth fixing.' },
  { n: '02', title: 'Build Fast', body: 'Make the simplest version that people can actually use.' },
  { n: '03', title: 'Keep Improving', body: 'Learn from feedback and refine what matters most.' },
];
---
<section class="how" id="how-we-build" aria-labelledby="how-title">
  <div class="wrap">
    <div class="section-head" data-reveal="head" data-reveal-group>
      <h2 id="how-title">How We Build</h2>
      <p>We start from small, real problems and shape them into simple, useful products.</p>
    </div>

    <ol class="steps" data-steps>
      {steps.map((s, i) => (
        <li class="step" style={`--s:${i}`}>
          <span class="num">
            {i === 0 && (
              <>
                <Image src={step1} {...img} />
                <span class="twinkle" style="--x:76%;--y:31.7%" aria-hidden="true"></span>
              </>
            )}
            {i === 1 && (
              <>
                <Image src={rocketBg} {...img} />
                <span class="rig" aria-hidden="true">
                  <Image src={flame} {...img} class="flame" />
                  <Image src={rocket} {...img} />
                </span>
              </>
            )}
            {i === 2 && (
              <>
                <Image src={orbitBg} {...img} />
                <Image src={satellite} {...img} class="sat" data-sat />
              </>
            )}
            <span class="sr-only">Step {s.n}</span>
          </span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .how {
    padding-block: clamp(96px, 13vw, 168px) clamp(72px, 9vw, 120px);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(28px, 4vw, 56px);
    margin: clamp(48px, 6vw, 80px) 0 0;
    padding: 0;
    list-style: none;
  }

  .step {
    position: relative;
    display: grid;
    align-content: start;
    gap: 10px;
  }

  .num,
  .step h3,
  .step p {
    transition:
      opacity 0.8s var(--ease-out),
      transform 0.8s var(--ease-out),
      filter 0.8s var(--ease-out);
    transition-delay: calc(0.15s + var(--s) * 0.18s);
  }

  .steps[data-armed]:not([data-inview]) :is(.num, h3, p) {
    opacity: 0;
    transform: translateY(14px);
  }

  .steps[data-armed]:not([data-inview]) .num {
    filter: blur(8px);
  }

  @media (prefers-reduced-motion: reduce) {
    .steps[data-armed]:not([data-inview]) :is(.num, h3, p) {
      transform: none;
      filter: none;
    }
  }

  /* The illustrations sit on the same navy as the page: lighten drops their background,
     and the radial mask softens the square's edges. */
  .num {
    display: block;
    width: clamp(240px, 26vw, 340px);
    max-width: 100%;
    aspect-ratio: 1;
    margin: -24px 0 0 -34px;
  }

  .num :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    mix-blend-mode: lighten;
    -webkit-mask-image: radial-gradient(closest-side, #000 72%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 72%, transparent 100%);
  }

  .num {
    position: relative;
  }

  /* layers sit exactly on top of the background */
  .num :global(img + img),
  .rig,
  .rig :global(img) {
    position: absolute;
    inset: 0;
  }

  /* Step 2: the rocket shakes on its thrust, the flame flickers from the nozzle */
  .rig {
    transform-origin: 60% 40%;
    animation: shake 2.4s ease-in-out infinite;
  }

  .rig :global(.flame) {
    transform-origin: 48.7% 50.8%;
    animation: thrust 0.6s ease-in-out infinite alternate;
  }

  /* a soft sway along the flight line, not a jitter */
  @keyframes shake {
    0%, 100% { translate: 0 0; rotate: 0deg; }
    25% { translate: 0.45% -0.4%; rotate: 0.6deg; }
    50% { translate: 0.1% 0.15%; rotate: -0.3deg; }
    75% { translate: -0.35% 0.3%; rotate: 0.4deg; }
  }

  @keyframes thrust {
    from { scale: 0.93; opacity: 0.82; }
    to { scale: 1.06; opacity: 1; }
  }

  /* Step 3: the script moves the satellite round its orbit */
  .num :global(.sat) {
    transform-origin: 75.5% 30%;
    will-change: transform, opacity;
  }

  /* Step 1: the star the astronaut is looking at blinks */
  .twinkle {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 9%;
    aspect-ratio: 1;
    translate: -50% -50%;
    pointer-events: none;
    mix-blend-mode: screen;
    background:
      radial-gradient(closest-side, rgb(255 236 205 / 0.95), rgb(255 190 130 / 0.35) 45%, transparent 75%),
      linear-gradient(90deg, transparent 47%, rgb(255 225 185 / 0.9) 50%, transparent 53%),
      linear-gradient(0deg, transparent 47%, rgb(255 225 185 / 0.9) 50%, transparent 53%);
    -webkit-mask-image: radial-gradient(closest-side, #000 35%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 35%, transparent 100%);
    animation: twinkle 3.4s ease-in-out infinite;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.15; scale: 0.55; }
    45% { opacity: 1; scale: 1.15; }
    60% { opacity: 0.85; scale: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .twinkle {
      animation: none;
      opacity: 0.7;
    }

    .rig,
    .rig :global(.flame) {
      animation: none;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .step h3 {
    font-size: 1.3125rem;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .step p {
    max-width: 22rem;
    color: var(--text-2);
  }

  @media (max-width: 760px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .num {
      margin-bottom: 8px;
    }
  }
</style>

<script>
  const list = document.querySelector<HTMLElement>('[data-steps]');
  if (list && 'IntersectionObserver' in window) {
    const rect = list.getBoundingClientRect();
    // Only arm the reveal when the list starts below the fold; content is visible by default.
    if (rect.top > window.innerHeight) {
      list.setAttribute('data-armed', '');
      const io = new IntersectionObserver(
        ([e]) => {
          if (e.isIntersecting) {
            list.setAttribute('data-inview', '');
            io.disconnect();
          }
        },
        { threshold: 0.3 },
      );
      io.observe(list);
    }
  }
</script>

<script>
  /* Step 3: the satellite circles the planet along the painted orbit ring. The ring and the
     planet were measured on the illustration (fractions of the image). On the far side of
     the orbit the satellite slips behind the planet. */
  const sat = document.querySelector<HTMLElement>('[data-sat]');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (sat && !calm) {
    const RING = { cx: 0.5103, cy: 0.5261, a: 0.1218, b: 0.3526, deg: 64.89 };
    const PLANET = { cx: 0.49, cy: 0.4925, r: 0.2146 };
    const HOME = { x: 0.7554, y: 0.3001 }; // where the satellite is painted
    const PERIOD = 26000; // ms per orbit

    const th = (RING.deg * Math.PI) / 180;
    const u = { x: Math.cos(th), y: Math.sin(th) }; // short axis (front = +u)
    const v = { x: -Math.sin(th), y: Math.cos(th) }; // long axis
    const at = (t: number) => ({
      x: RING.cx + RING.a * Math.cos(t) * u.x + RING.b * Math.sin(t) * v.x,
      y: RING.cy + RING.a * Math.cos(t) * u.y + RING.b * Math.sin(t) * v.y,
    });

    // Start where it is painted, keeping its small lift off the ring line.
    let t0 = 0;
    let best = Infinity;
    for (let i = 0; i < 720; i++) {
      const t = (i / 720) * Math.PI * 2;
      const p = at(t);
      const d = (p.x - HOME.x) ** 2 + (p.y - HOME.y) ** 2;
      if (d < best) { best = d; t0 = t; }
    }
    const lift = { x: HOME.x - at(t0).x, y: HOME.y - at(t0).y };

    const smooth = (e0: number, e1: number, x: number) => {
      const k = Math.min(1, Math.max(0, (x - e0) / (e1 - e0)));
      return k * k * (3 - 2 * k);
    };

    let visible = false;
    let elapsed = 0; // only counts while on screen, so it carries on where it stopped
    let last = 0;
    let frame = 0;
    const tick = (now: number) => {
      if (last) elapsed += Math.min(100, now - last);
      last = now;
      const t = t0 + (elapsed / PERIOD) * Math.PI * 2;
      const p = at(t);
      const x = p.x + lift.x;
      const y = p.y + lift.y;
      const back = Math.cos(t) < 0; // the half of the ring that runs behind the planet
      const dist = Math.hypot(x - PLANET.cx, y - PLANET.cy);
      const shown = back ? smooth(PLANET.r - 0.01, PLANET.r + 0.035, dist) : 1;
      const scale = 0.9 + 0.1 * (0.5 + 0.5 * Math.cos(t)); // a touch smaller on the far side
      sat.style.transform = `translate(${((x - HOME.x) * 100).toFixed(2)}%, ${((y - HOME.y) * 100).toFixed(2)}%) scale(${scale.toFixed(3)})`;
      sat.style.opacity = shown.toFixed(3);
      if (visible) frame = requestAnimationFrame(tick);
    };

    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      cancelAnimationFrame(frame);
      last = 0;
      if (visible) frame = requestAnimationFrame(tick);
    }).observe(sat);
  }
</script>
