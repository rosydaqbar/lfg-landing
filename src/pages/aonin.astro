<script>
  /* The grille meters move like live audio; now and then one hole flashes orange for a
     repaired packet, the way the real app does. */
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const meters = Array.from(document.querySelectorAll<SVGGElement>('[data-meter]'));

  if (calm) {
    document.querySelectorAll<SVGSVGElement>('.ao-flow').forEach((s) => s.pauseAnimations());
  }

  if (!calm && meters.length) {
    const rows = meters.map((m) => ({
      holes: Array.from(m.querySelectorAll<SVGCircleElement>('circle')),
      base: Number(m.dataset.level ?? 0),
      level: Number(m.dataset.level ?? 0),
      muted: m.hasAttribute('data-muted'),
      seed: Math.random() * 10,
    }));

    let t = 0;
    window.setInterval(() => {
      if (document.hidden) return;
      t += 0.09;
      for (const r of rows) {
        if (r.muted) continue;
        const target = Math.max(0.05, Math.min(1, r.base + Math.sin(t * 0.9 + r.seed) * 0.18 + (Math.random() - 0.5) * 0.28));
        r.level += (target - r.level) * 0.55;
        const lit = Math.round(r.level * r.holes.length);
        r.holes.forEach((h, i) => h.classList.toggle('on', i < lit));
        if (Math.random() < 0.012 && lit > 1) {
          const h = r.holes[lit - 1];
          h.classList.add('flash');
          window.setTimeout(() => h.classList.remove('flash'), 700);
        }
      }
    }, 90);
  }
</script>
