---
// Shared SVG definitions for product scenes: the same emboss language as the page's buttons and cards.
interface Props { id: string }
const { id } = Astro.props;
---
<defs>
  <linearGradient id={`${id}-panel`} x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#1d2645" />
    <stop offset="1" stop-color="#121a31" />
  </linearGradient>
  <linearGradient id={`${id}-panel-back`} x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#161e38" />
    <stop offset="1" stop-color="#0f1629" />
  </linearGradient>
  <linearGradient id={`${id}-blue`} x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#4a80ff" />
    <stop offset="0.55" stop-color="#2860f0" />
    <stop offset="1" stop-color="#1f54de" />
  </linearGradient>
  <linearGradient id={`${id}-slate`} x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#2a3048" />
    <stop offset="1" stop-color="#1c2135" />
  </linearGradient>
  <linearGradient id={`${id}-rose`} x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#b8566a" />
    <stop offset="1" stop-color="#8f3a4d" />
  </linearGradient>
  <linearGradient id={`${id}-shine`} x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#fff" stop-opacity="0.22" />
    <stop offset="1" stop-color="#fff" stop-opacity="0" />
  </linearGradient>
  <filter id={`${id}-lift`} x="-20%" y="-20%" width="140%" height="160%">
    <feDropShadow dx="0" dy="14" stdDeviation="14" flood-color="#030712" flood-opacity="0.6" />
  </filter>
  <filter id={`${id}-glow`} x="-50%" y="-50%" width="200%" height="200%">
    <feGaussianBlur stdDeviation="6" />
  </filter>
</defs>
