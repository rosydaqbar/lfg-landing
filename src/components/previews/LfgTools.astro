---
// LFG Tools: a Discord sidebar with a join-to-create lobby, and the LFG post the bot keeps up
// to date. A new player drops into the room and fills a slot.
import PvDefs from './PvDefs.astro';
import Panel from './Panel.astro';

const id = 'lt';
const tones = ['#7f8fc8', 'var(--dust)', '#6f8fb0'];
const members = [
  { name: 'aelita', y: 158 },
  { name: 'drew', y: 176 },
  { name: 'kugel', y: 194 },
];
const speaker = 'l-4 3.5 h-3 v4 h3 l4 3.5 z';
---
<svg class="pv pv-lfg" viewBox="0 0 480 285" aria-hidden="true">
  <PvDefs id={id} />

  <!-- server sidebar -->
  <Panel id={id} x={24} y={28} w={168} h={229} back>
    <text x="40" y="52" class="t t-strong">LFG Squad</text>
    <path d="M172 47 l4 4 4 -4" class="s-icon" />
    <path d="M24 66.5 H 192" class="hair" />
    <text x="40" y="86" class="t t-cap">VOICE CHANNELS</text>

    <g class="lt-lobby">
      <rect x="32" y="94" width="152" height="26" rx="8" class="f-blue-soft" />
      <path d={`M48 101.5 ${speaker}`} class="lt-spk lt-spk--blue" />
      <text x="58" y="111" class="t t-strong">Join to Create</text>
      <path d="M172 102 v10 M167 107 h10" class="lt-plus" />
    </g>

    <path d={`M48 132.5 ${speaker}`} class="lt-spk" />
    <text x="58" y="142" class="t t-strong">Ranked grind</text>
    <text x="180" y="142" class="t t-meta lt-n3" text-anchor="end">3/5</text>
    <text x="180" y="142" class="t t-meta t-blue lt-n4" text-anchor="end">4/5</text>

    {members.map((m, i) => (
      <g>
        <circle cx="64" cy={m.y - 3.5} r="6" style={`fill:${tones[i]}`} />
        {i === 0 && <circle cx="64" cy={m.y - 3.5} r="8.5" class="lt-speak" />}
        <text x="78" y={m.y} class="t t-meta">{m.name}</text>
      </g>
    ))}
    <g class="lt-you">
      <circle cx="64" cy="208.5" r="6" class="f-ink" />
      <text x="78" y="212" class="t t-meta t-strong">you</text>
    </g>

    <path d={`M48 230.5 ${speaker}`} class="lt-spk" />
    <text x="58" y="240" class="t">Chill corner</text>
    <text x="180" y="240" class="t t-meta" text-anchor="end">2</text>
  </Panel>

  <!-- the LFG post -->
  <Panel id={id} x={204} y={62} w={252} h={168}>
    <circle cx="230" cy="86" r="10" class="f-blue" />
    <path d="M225 82.5 h10 M225 86 h7 M225 89.5 h9" stroke="#fff" stroke-width="1.6" stroke-linecap="round" />
    <text x="248" y="84" class="t t-strong">LFG Tools</text>
    <rect x="303" y="75" width="24" height="12" rx="3" class="f-blue-soft" />
    <text x="315" y="84" class="t t-cap t-blue" text-anchor="middle">APP</text>
    <text x="248" y="96" class="t t-meta">Looking for group</text>

    <text x="220" y="124" class="t t-title">Ranked grind</text>
    <text x="220" y="139" class="t t-meta lt-need2">Need 2 more · join the room to play</text>
    <text x="220" y="139" class="t t-meta lt-need1">Need 1 more · join the room to play</text>

    <g transform="translate(220 152)">
      {[0, 1, 2].map((s) => (
        <circle cx={12 + s * 30} cy="12" r="12" style={`fill:${tones[s]}`} />
      ))}
      <circle cx="102" cy="12" r="11.5" class="lt-slot" />
      <circle cx="102" cy="12" r="12" class="f-ink lt-slot-you" />
      <circle cx="132" cy="12" r="11.5" class="lt-slot" />
    </g>

    <g transform="translate(220 188)">
      <rect width="92" height="26" rx="8" class="f-blue" />
      <text x="46" y="16.8" class="t t-on" text-anchor="middle">Join room</text>
    </g>
    <g transform="translate(320 188)">
      <rect x="0.5" y="0.5" width="79" height="25" rx="7.5" class="s-line" />
      <text x="40" y="16.8" class="t t-strong" text-anchor="middle">My stats</text>
    </g>
  </Panel>
</svg>

<style>
  .pv-lfg {
    --loop: 6s;
  }

  .lt-plus {
    stroke: var(--blue-hi);
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .lt-spk {
    fill: var(--text-3);
  }

  .lt-spk--blue {
    fill: var(--blue-hi);
  }

  .lt-speak {
    fill: none;
    stroke: var(--dust);
    stroke-width: 1.4;
    animation: lt-speak 1.4s ease-in-out infinite;
  }

  @keyframes lt-speak {
    50% { opacity: 0.2; }
  }

  /* the new player appears in the room, then fills the next slot */
  .lt-you {
    animation: lt-you var(--loop) var(--ease-out) infinite;
  }

  @keyframes lt-you {
    0%, 22% { opacity: 0; transform: translateY(-6px); }
    32%, 92% { opacity: 1; transform: none; }
    100% { opacity: 0; }
  }

  .lt-n3, .lt-need2 { animation: lt-before var(--loop) linear infinite; }
  .lt-n4, .lt-need1 { animation: lt-after var(--loop) linear infinite; }

  @keyframes lt-before {
    0%, 34% { opacity: 1; }
    36%, 92% { opacity: 0; }
    100% { opacity: 1; }
  }

  @keyframes lt-after {
    0%, 34% { opacity: 0; }
    36%, 92% { opacity: 1; }
    100% { opacity: 0; }
  }

  .lt-slot {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.2;
    stroke-dasharray: 3 3;
  }

  .lt-slot-you {
    transform-box: fill-box;
    transform-origin: center;
    animation: lt-slot var(--loop) var(--ease-out) infinite;
  }

  @keyframes lt-slot {
    0%, 38% { opacity: 0; transform: scale(0.5); }
    46%, 92% { opacity: 1; transform: none; }
    100% { opacity: 0; }
  }
</style>
