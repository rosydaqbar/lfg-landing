---
// Spam Catcher: an attachment burst lands in #general, gets boxed as one incident, and the
// bot posts its review card (timeout, AI verdict, delete).
import PvDefs from './PvDefs.astro';
import Panel from './Panel.astro';

const id = 'sc';
---
<svg class="pv pv-spam" viewBox="0 0 480 285" aria-hidden="true">
  <PvDefs id={id} />

  <!-- the channel, behind -->
  <Panel id={id} x={24} y={28} w={250} h={229} back>
    <text x="40" y="52" class="t t-meta">#</text>
    <text x="50" y="52" class="t t-strong">general</text>
    <path d="M24 66.5 H 274" class="hair" />

    <circle cx="50" cy="90" r="10" class="sc-av1" />
    <text x="68" y="88" class="t t-strong">mika</text>
    <text x="96" y="88" class="t t-meta">21:04</text>
    <rect x="68" y="94" width="148" height="6" rx="3" class="f-chip" />

    <circle cx="50" cy="128" r="10" class="sc-av2" />
    <text x="68" y="126" class="t t-strong">new_member</text>
    <text x="148" y="126" class="t t-meta">21:05</text>

    <!-- the burst: four images, boxed together as one incident -->
    <g transform="translate(68 136)">
      {[0, 1, 2, 3].map((i) => (
        <g transform={`translate(${(i % 2) * 66} ${Math.floor(i / 2) * 42})`}>
          <g class="sc-tile" style={`--t:${i}`}>
            <rect width="60" height="36" rx="6" class="f-chip" />
            <path d="M8 29 l12-12 9 8 6-5 13 9z" class="sc-glyph" />
            <circle cx="45" cy="11" r="4" class="sc-glyph" />
          </g>
        </g>
      ))}
      <rect x="-6" y="-6" width="138" height="90" rx="10" class="sc-trap" />
      <text x="0" y="98" class="t t-meta t-blue sc-trap">+2 more files</text>
    </g>
  </Panel>

  <!-- the bot's review card, in front -->
  <g class="sc-card">
    <Panel id={id} x={214} y={58} w={242} h={190}>
      <circle cx="240" cy="82" r="10" class="f-blue" />
      <path d="M240 76 l5 1.8 v3.6 c0 3.4-5 5.6-5 5.6 s-5-2.2-5-5.6 v-3.6z" fill="#fff" />
      <text x="258" y="80" class="t t-strong">Spam Catcher</text>
      <rect x="337" y="71" width="24" height="12" rx="3" class="f-blue-soft" />
      <text x="349" y="80" class="t t-cap t-blue" text-anchor="middle">APP</text>
      <text x="258" y="92" class="t t-meta">Incident</text>

      <text x="230" y="122" class="t t-title">Attachment burst</text>
      <g class="sc-sev" transform="translate(386 109)">
        <rect x="0.5" y="0.5" width="53" height="17" rx="8.5" class="sc-danger-pill" />
        <text x="27" y="12" class="t t-meta t-danger" text-anchor="middle">Danger</text>
      </g>

      <text x="230" y="146" class="t t-cap">USER</text>
      <text x="230" y="159" class="t t-strong">new_member</text>
      <text x="336" y="146" class="t t-cap">BURST</text>
      <text x="336" y="159" class="t t-strong">6 files · 4 s</text>
      <text x="230" y="180" class="t t-cap">ACTION</text>
      <text x="230" y="193" class="t t-strong">Timed out 10 min</text>
      <text x="336" y="180" class="t t-cap">AI VERDICT</text>
      <text x="336" y="193" class="t t-strong sc-verdict">Scam image</text>

      <g transform="translate(230 208)">
        <rect width="106" height="26" rx="8" class="sc-delete" />
        <text x="53" y="16.8" class="t t-on" text-anchor="middle">Delete messages</text>
      </g>
      <g transform="translate(344 208)">
        <rect x="0.5" y="0.5" width="95" height="25" rx="7.5" class="s-line" />
        <text x="48" y="16.8" class="t t-strong" text-anchor="middle">Dismiss</text>
      </g>
    </Panel>
  </g>
</svg>

<style>
  .pv-spam {
    --loop: 7s;
  }

  .sc-av1 { fill: #7f8fc8; }
  .sc-av2 { fill: var(--dust); }

  .sc-glyph {
    fill: rgb(214 224 255 / 0.16);
  }

  .sc-danger-pill {
    fill: rgb(228 140 155 / 0.1);
    stroke: rgb(228 140 155 / 0.45);
  }

  .sc-delete {
    fill: #b5566b;
  }

  .sc-tile {
    animation: sc-tile var(--loop) var(--ease-out) infinite;
    animation-delay: calc(var(--t) * 0.12s);
  }

  @keyframes sc-tile {
    0% { opacity: 0; transform: translateY(-8px); }
    7%, 92% { opacity: 1; transform: none; }
    100% { opacity: 0; }
  }

  rect.sc-trap {
    fill: rgb(74 128 255 / 0.06);
    stroke: var(--blue-hi);
    stroke-width: 1.2;
    stroke-dasharray: 4 4;
  }

  .sc-trap {
    animation: sc-trap var(--loop) var(--ease-out) infinite;
  }

  @keyframes sc-trap {
    0%, 16% { opacity: 0; }
    24%, 92% { opacity: 1; }
    100% { opacity: 0; }
  }

  .sc-card {
    animation: sc-card var(--loop) var(--ease-out) infinite;
  }

  @keyframes sc-card {
    0%, 24% { opacity: 0; transform: translate(16px, 0); }
    36%, 92% { opacity: 1; transform: none; }
    100% { opacity: 0; }
  }

  .sc-sev {
    animation: sc-sev var(--loop) ease-in-out infinite;
  }

  @keyframes sc-sev {
    0%, 40% { opacity: 0; }
    46%, 92% { opacity: 1; }
    100% { opacity: 0; }
  }

  .sc-verdict {
    animation: sc-verdict var(--loop) linear infinite;
  }

  @keyframes sc-verdict {
    0%, 52% { opacity: 0; }
    56%, 92% { opacity: 1; }
    100% { opacity: 0; }
  }
</style>
