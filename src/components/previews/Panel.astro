---
// A flat panel: one surface colour, a hairline edge and the shared soft shadow.
interface Props { id: string; x: number; y: number; w: number; h: number; r?: number; back?: boolean; class?: string }
const { id, x, y, w, h, r = 12, back = false, class: cls } = Astro.props;
---
<g class={cls} filter={`url(#${id}-lift)`}>
  <rect x={x + 0.5} y={y + 0.5} width={w - 1} height={h - 1} rx={r} class={back ? 'pv-panel pv-panel--back' : 'pv-panel'} />
  <slot />
</g>
