---
import Icon from './Icon.astro';
import { contactHref } from '../data/site';

// On the home page anchors scroll in place; on other pages they lead home first.
const base = Astro.url.pathname === '/' ? '' : '/';
const links = [
  { href: `${base}#products`, label: 'Products' },
  { href: `${base}#how-we-build`, label: 'How We Build' },
  { href: `${base}#contact`, label: 'Contact' },
];
---
<header class="nav-shell" data-nav>
  <nav class="nav" aria-label="Main">
    <span class="sky-glow" aria-hidden="true">
      <span class="dust"></span>
      <i class="star s1"></i>
      <i class="star s2"></i>
    </span>
    <span class="rim" aria-hidden="true"></span>
    <a class="brand" href={base ? "/" : "#top"} aria-label="LFG.ink home">
      LFG<span>.ink</span>
    </a>

    <ul class="links" id="nav-links">
      {links.map((l) => (
        <li><a href={l.href} data-umami-event="nav_click" data-umami-event-target={l.label} data-umami-event-location="nav">{l.label}</a></li>
      ))}
    </ul>

    <div class="end">
      <a class="btn btn--primary btn--sm" href={contactHref} data-umami-event="contact_click" data-umami-event-location="nav">Contact Us</a>
      <button class="toggle" type="button" aria-expanded="false" aria-controls="nav-links" data-nav-toggle>
        <span class="sr-only">Menu</span>
        <Icon name="menu" class="i-menu" />
        <Icon name="x" class="i-x" />
      </button>
    </div>
  </nav>
</header>

<style>
  .nav-shell {
    position: fixed;
    inset: 14px 0 auto;
    z-index: 50;
    padding-inline: 14px;
    pointer-events: none;
  }

  .nav {
    pointer-events: auto;
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    max-width: 920px;
    height: 58px;
    margin-inline: auto;
    padding: 0 9px 0 22px;
    border-radius: 999px;
    isolation: isolate;
    /* At the top of the page the nav sits directly on the hero: no pill. */
    background: rgb(12 17 30 / 0);
    -webkit-backdrop-filter: blur(0) saturate(1);
    backdrop-filter: blur(0) saturate(1);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0),
      0 0 0 1px rgb(214 224 255 / 0),
      0 12px 32px -14px rgb(0 0 0 / 0);
    transition:
      background-color 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out),
      -webkit-backdrop-filter 0.5s var(--ease-out),
      backdrop-filter 0.5s var(--ease-out);
  }

  /* Once the page scrolls (or the mobile menu opens), the pill forms around it. */
  .nav-shell[data-scrolled] .nav,
  .nav[data-open] {
    background: rgb(12 17 30 / 0.8);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    backdrop-filter: blur(18px) saturate(1.4);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.07),
      0 0 0 1px rgb(214 224 255 / 0.09),
      0 12px 32px -14px rgb(0 0 0 / 0.7);
  }

  /* ---------- scrolled pill, on hover: the same soft galaxy as the product cards ---------- */
  .sky-glow,
  .rim {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }

  .sky-glow {
    overflow: hidden;
    background: radial-gradient(220px circle at var(--mx, 50%) var(--my, 50%), rgb(150 120 255 / 0.16), rgb(80 150 255 / 0.06) 45%, transparent 72%);
  }

  .rim {
    padding: 1px;
    background: radial-gradient(180px circle at var(--mx, 50%) var(--my, 50%), rgb(185 172 216 / 0.6), rgb(110 140 255 / 0.2) 40%, transparent 70%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
  }

  .nav-shell[data-scrolled] .nav:hover .sky-glow,
  .nav-shell[data-scrolled] .nav:hover .rim {
    opacity: 1;
  }

  .dust {
    position: absolute;
    left: 0;
    top: 0;
    width: 1.5px;
    height: 1.5px;
    border-radius: 50%;
    color: var(--dust);
    box-shadow:
      70px 12px 0 0 currentColor, 160px 44px 0 0 #fff, 250px 18px 0 -0.3px currentColor,
      330px 47px 0 0 currentColor, 520px 10px 0 -0.2px #fff, 600px 46px 0 0 currentColor,
      690px 16px 0 -0.3px currentColor, 770px 42px 0 0 #fff, 860px 20px 0 -0.2px currentColor,
      420px 50px 0 -0.4px #fff;
    opacity: 0.55;
    animation: nav-dust 9s ease-in-out infinite;
    animation-play-state: paused;
  }

  .star {
    position: absolute;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 6px 1px rgb(200 215 255 / 0.7);
    opacity: 0.2;
    animation: nav-star 4.8s ease-in-out infinite;
    animation-play-state: paused;
  }

  .star.s1 { left: 27%; top: 14px; }
  .star.s2 { right: 24%; bottom: 13px; animation-duration: 6.4s; animation-delay: -2.3s; }

  .nav:hover .dust,
  .nav:hover .star {
    animation-play-state: running;
  }

  @keyframes nav-dust {
    0%, 100% { translate: 0 0; opacity: 0.4; }
    50% { translate: 4px -3px; opacity: 0.75; }
  }

  @keyframes nav-star {
    0%, 100% { opacity: 0.15; }
    50% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dust,
    .star {
      animation: none;
      opacity: 0.6;
    }
  }

  .brand {
    justify-self: start;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .brand span {
    font-weight: 500;
    color: var(--text-3);
  }

  .links {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: block;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 14.5px;
    font-weight: 480;
    color: var(--text-2);
    transition: color 0.2s, background-color 0.2s;
  }

  .links a:hover {
    color: var(--text);
    background: rgb(214 224 255 / 0.06);
  }

  .end {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .toggle {
    display: none;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 999px;
    background: rgb(214 224 255 / 0.06);
    color: var(--text);
    cursor: pointer;
  }

  .toggle :global(svg) {
    width: 18px;
    height: 18px;
  }

  .toggle :global(.i-x),
  .toggle[aria-expanded='true'] :global(.i-menu) {
    display: none;
  }

  .toggle[aria-expanded='true'] :global(.i-x) {
    display: block;
  }

  @media (max-width: 760px) {
    .nav {
      grid-template-columns: 1fr auto;
      padding-left: 20px;
    }

    .toggle {
      display: grid;
    }

    .links {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      right: 0;
      flex-direction: column;
      padding: 8px;
      border-radius: 24px;
      background: #0d1322;
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.06),
        0 0 0 1px rgb(214 224 255 / 0.09),
        0 18px 40px -16px rgb(0 0 0 / 0.8);
      opacity: 0;
      transform: translateY(-6px);
      visibility: hidden;
      transition:
        opacity 0.25s var(--ease-out),
        transform 0.35s var(--ease-out),
        visibility 0s 0.35s;
    }

    .nav[data-open] .links {
      opacity: 1;
      transform: none;
      visibility: visible;
      transition:
        opacity 0.25s var(--ease-out),
        transform 0.35s var(--ease-out);
    }

    .links a {
      padding: 12px 16px;
      font-size: 16px;
      border-radius: 16px;
    }
  }
</style>

<script>
  const shell = document.querySelector<HTMLElement>('[data-nav]');
  const nav = shell?.querySelector<HTMLElement>('.nav');
  const toggle = shell?.querySelector<HTMLButtonElement>('[data-nav-toggle]');

  const setOpen = (open: boolean) => {
    if (!nav || !toggle) return;
    toggle.setAttribute('aria-expanded', String(open));
    nav.toggleAttribute('data-open', open);
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  nav?.querySelectorAll('.links a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));

  // The hover glow follows the pointer (mouse and pen only).
  let frame = 0;
  nav?.addEventListener('pointermove', (e) => {
    if (e.pointerType === 'touch') return;
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(() => {
      const r = nav.getBoundingClientRect();
      nav.style.setProperty('--mx', `${e.clientX - r.left}px`);
      nav.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });

  const onScroll = () => shell?.toggleAttribute('data-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
