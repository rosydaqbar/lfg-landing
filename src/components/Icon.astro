---
type Name =
  | 'arrow-up-right' | 'arrow-right' | 'mail' | 'menu' | 'x' | 'github' | 'discord'
  | 'headphones' | 'laptop' | 'volume' | 'hash' | 'shield' | 'clock' | 'users';
interface Props { name: Name; class?: string; }
const { name, class: cls } = Astro.props;
const filled = name === 'github' || name === 'discord';
---
<svg
  class={cls}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'arrow-up-right' && <path d="M7 17 17 7M8 7h9v9" />}
  {name === 'arrow-right' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7 8 6 8-6" /></>}
  {name === 'menu' && <path d="M4 8h16M4 16h16" />}
  {name === 'x' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'headphones' && <path d="M4 15v-3a8 8 0 0 1 16 0v3M4 15h2.5a1.5 1.5 0 0 1 1.5 1.5v2A1.5 1.5 0 0 1 6.5 20H5.5A1.5 1.5 0 0 1 4 18.5V15Zm16 0h-2.5a1.5 1.5 0 0 0-1.5 1.5v2a1.5 1.5 0 0 0 1.5 1.5h1a1.5 1.5 0 0 0 1.5-1.5V15Z" />}
  {name === 'laptop' && <><rect x="4" y="5" width="16" height="11" rx="1.5" /><path d="M2 19h20" /></>}
  {name === 'volume' && <><path d="M11 5 6.5 9H3v6h3.5l4.5 4V5Z" /><path d="M15.5 9a4.5 4.5 0 0 1 0 6M18.5 6.5a8 8 0 0 1 0 11" /></>}
  {name === 'hash' && <path d="M5 9h15M4 15h15M10 4 8 20M16 4l-2 16" />}
  {name === 'shield' && <path d="M12 21s7-3.5 7-9.5V6l-7-2.5L5 6v5.5C5 17.5 12 21 12 21Z" />}
  {name === 'clock' && <><circle cx="12" cy="12" r="8" /><path d="M12 8v4l2.5 2" /></>}
  {name === 'users' && <><circle cx="9" cy="9" r="3" /><path d="M3.5 19a5.5 5.5 0 0 1 11 0M16 6.5a3 3 0 0 1 0 5.5M18 19a5 5 0 0 0-2.5-4.3" /></>}
  {name === 'github' && <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />}
  {name === 'discord' && <path d="M20.3 4.4A19.6 19.6 0 0 0 15.4 3l-.6 1.3a18 18 0 0 0-5.6 0L8.6 3a19.5 19.5 0 0 0-4.9 1.5C.6 9.1-.3 13.6.1 18.1A19.8 19.8 0 0 0 6.1 21l1.3-2a12.8 12.8 0 0 1-2-1l.5-.4a14 14 0 0 0 12.2 0l.5.4c-.6.4-1.3.7-2 1l1.3 2a19.7 19.7 0 0 0 6-3c.5-5.2-.8-9.7-3.6-13.6ZM8.1 15.3c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Zm7.8 0c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Z" />}
