---
// Aonin: the listener's popover. Three computers on the LAN send their audio in, each with a
// live level, and everything plays on one pair of headphones.
import PvDefs from './PvDefs.astro';
import Panel from './Panel.astro';

const id = 'ao';
// popover: x 128..352, rows start at y 98, 38 apart
const devices = [
  { name: 'MacBook Pro', src: 'System audio' },
  { name: 'Studio Mac', src: 'System audio + mic' },
  { name: 'ThinkPad', src: 'System audio' },
];
const rowY = (i: number) => 98 + i * 38;
const bars = [0, 1, 2, 3, 4];
---
<svg class="pv pv-aonin" viewBox="0 0 480 285" aria-hidden="true">
  <PvDefs id={id} />

  <!-- the other computers, wired into their rows -->
  {devices.map((_, i) => {
    const cy = rowY(i) + 17;
    return (
      <g>
        <g transform={`translate(38 ${cy - 10})`} class="ao-laptop">
          <rect x="3" y="0" width="24" height="16" rx="2.5" class="s-icon" />
          <path d="M0 19.5 H 30" class="s-icon" />
        </g>
        <path d={`M76 ${cy} H 128`} class="ao-wire" style={`--i:${i}`} />
      </g>
    );
  })}

  <!-- out to the headphones -->
  <path d="M352 236 H 392" class="ao-wire ao-wire--out" />
  <g transform="translate(398 214)" class="ao-phones">
    <path d="M4 26 V 20 a 18 18 0 0 1 36 0 V 26" class="s-icon" />
    <rect x="0" y="22" width="10" height="18" rx="4" class="ao-cup" />
    <rect x="34" y="22" width="10" height="18" rx="4" class="ao-cup" />
  </g>

  <Panel id={id} x={128} y={28} w={224} h={229}>
    <!-- header -->
    <g transform="translate(144 39)">
      <rect width="22" height="22" rx="6" fill="#d9d8d6" />
      {[0, 1, 2].map((r) => [0, 1, 2].map((c) => (
        <circle cx={5.5 + c * 5.5} cy={5.5 + r * 5.5} r="1.8" fill={r === 1 && c === 1 ? '#e9682e' : '#8f8e8b'} />
      )))}
    </g>
    <text x="176" y="49" class="t t-strong">Aonin</text>
    <text x="176" y="61" class="t t-meta">This Mac</text>
    <g transform="translate(270 40)">
      <rect x="0.5" y="0.5" width="66" height="19" rx="9.5" class="f-blue-soft" />
      <circle cx="11" cy="10" r="3" class="f-blue ao-live" />
      <text x="20" y="13.5" class="t t-meta t-blue">Listening</text>
    </g>
    <path d="M128 72.5 H 352" class="hair" />

    <text x="144" y="90" class="t t-cap">AUDIO SENDERS · 3</text>
    {devices.map((d, i) => {
      const y = rowY(i);
      return (
        <g>
          {i === 0 && <rect x="136" y={y} width="208" height="34" rx="8" class="f-row" />}
          <g transform={`translate(146 ${y + 11})`}>
            <rect x="2" y="0" width="15" height="10" rx="2" class="s-icon" />
            <path d="M0 12.5 H 19" class="s-icon" />
          </g>
          <text x="174" y={y + 15} class="t t-strong">{d.name}</text>
          <text x="174" y={y + 27} class="t t-meta">{d.src}</text>
          <g transform={`translate(302 ${y + 10})`}>
            {bars.map((b) => (
              <rect x={b * 6} y="0" width="3" height="14" rx="1.5" class="ao-bar" style={`--b:${b};--i:${i}`} />
            ))}
          </g>
        </g>
      );
    })}

    <path d="M128 214.5 H 352" class="hair" />
    <g transform="translate(145 228)">
      <path d="M1.5 11 V 8 a 6.5 6.5 0 0 1 13 0 V 11" class="s-icon" />
      <rect x="0" y="9" width="4" height="6.5" rx="1.5" class="s-icon" />
      <rect x="12" y="9" width="4" height="6.5" rx="1.5" class="s-icon" />
    </g>
    <text x="170" y="240" class="t t-strong">AirPods Pro</text>
    <text x="336" y="240" class="t t-meta" text-anchor="end">18 ms</text>
  </Panel>
</svg>

<style>
  .ao-wire {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.5;
    stroke-dasharray: 2 5;
    stroke-linecap: round;
    animation: ao-flow 1.4s linear infinite;
    animation-delay: calc(var(--i, 0) * -0.45s);
  }

  .ao-wire--out {
    stroke: var(--dust);
    opacity: 0.7;
  }

  @keyframes ao-flow {
    to { stroke-dashoffset: -14; }
  }

  .ao-cup {
    fill: var(--ink-2);
    stroke: var(--text-2);
    stroke-width: 1.4;
  }

  .ao-live {
    animation: ao-live 2s ease-in-out infinite;
  }

  @keyframes ao-live {
    50% { opacity: 0.35; }
  }

  /* live levels: quiet lavender, the same dust as the wordmark */
  .ao-bar {
    fill: var(--dust);
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: ao-level 1.1s ease-in-out infinite alternate;
    animation-delay: calc(var(--b) * -0.19s + var(--i) * -0.43s);
  }

  @keyframes ao-level {
    0% { transform: scaleY(0.25); }
    40% { transform: scaleY(0.7); }
    70% { transform: scaleY(0.45); }
    100% { transform: scaleY(1); }
  }
</style>
