---
// corpo.best: the catalog of standout corporate homepages. Filter chips step through sectors
// and the "View site" spotlight moves across the index.
import PvDefs from './PvDefs.astro';
import Panel from './Panel.astro';

const id = 'cb';
const chips = [
  { label: 'All', w: 30 },
  { label: 'Aerospace', w: 62 },
  { label: 'Robotics', w: 56 },
  { label: 'Mobility', w: 54 },
  { label: 'Capital', w: 50 },
];
let cx = 0;
const chipPos = chips.map((c) => {
  const x = cx;
  cx += c.w + 6;
  return { ...c, x };
});
const chipRowW = cx - 6;
// three thumbnails, 116 wide, 12 apart, centred in the 416-wide browser
const thumbX = (i: number) => 54 + i * 128;
---
<svg class="pv pv-corpo" viewBox="0 0 480 285" aria-hidden="true">
  <PvDefs id={id} />

  <Panel id={id} x={32} y={22} w={416} h={241}>
    <!-- browser chrome -->
    <circle cx="49" cy="38" r="3.5" class="f-chip" />
    <circle cx="61" cy="38" r="3.5" class="f-chip" />
    <circle cx="73" cy="38" r="3.5" class="f-chip" />
    <rect x="186" y="30" width="108" height="16" rx="8" class="f-chip" />
    <text x="240" y="41.4" class="t t-meta" text-anchor="middle">corpo.best</text>
    <path d="M32 54.5 H 448" class="hair" />

    <!-- site nav -->
    <g transform="translate(176 66)">
      <rect x="0.5" y="0.5" width="127" height="21" rx="10.5" class="s-line" />
      <circle cx="12" cy="11" r="6.5" class="f-ink" />
      <text x="12" y="13.6" class="t t-dark" style="font-size:6px" text-anchor="middle">cb</text>
      <text x="24" y="14.5" class="t t-meta t-strong">corpo.best</text>
      <rect x="84" y="4" width="38" height="14" rx="7" class="f-ink" />
      <text x="103" y="13.8" class="t t-dark" style="font-size:8px" text-anchor="middle">Catalog</text>
    </g>

    <text x="240" y="114" class="t t-display" text-anchor="middle">Standout Corporate Sites</text>
    <text x="240" y="128" class="t t-meta" text-anchor="middle">An independent index of authentic corporate homepages</text>

    <!-- filter chips -->
    <g transform={`translate(${240 - chipRowW / 2} 138)`}>
      {chipPos.map((c) => (
        <g>
          <rect x={c.x} width={c.w} height="16" rx="8" class="f-chip" />
          <text x={c.x + c.w / 2} y="11" class="t t-meta" text-anchor="middle">{c.label}</text>
        </g>
      ))}
      {chipPos.map((c, i) => (
        <g class="cb-chip" style={`--i:${i}`}>
          <rect x={c.x} width={c.w} height="16" rx="8" class="f-ink" />
          <text x={c.x + c.w / 2} y="11" class="t t-meta t-dark" text-anchor="middle">{c.label}</text>
        </g>
      ))}
    </g>

    <!-- the index: three homepages, drawn flat and muted so they sit in the night palette -->
    <g transform="translate(0 166)">
      <g class="cb-site" style="--i:0" transform={`translate(${thumbX(0)} 0)`}>
        <rect width="116" height="80" rx="8" fill="#1d2b3a" />
        <circle cx="78" cy="44" r="20" fill="#8aa6c8" />
        <circle cx="66" cy="52" r="10" fill="#b9acd8" opacity="0.8" />
        <rect x="10" y="12" width="38" height="5" rx="2" fill="#dfe4ee" />
        <rect x="10" y="21" width="28" height="5" rx="2" fill="#dfe4ee" />
        <rect x="10" y="62" width="40" height="3" rx="1.5" fill="#6d7e93" />
        <rect x="10" y="68" width="30" height="3" rx="1.5" fill="#6d7e93" />
      </g>

      <g class="cb-site" style="--i:1" transform={`translate(${thumbX(1)} 0)`}>
        <rect width="116" height="80" rx="8" fill="#0d0f15" />
        <rect y="36" width="58" height="44" fill="#e6e2da" />
        <rect x="58" y="36" width="58" height="44" fill="#7a3a42" />
        <rect x="68" y="46" width="38" height="14" rx="2" fill="#c9a865" />
        <rect x="8" y="50" width="38" height="5" rx="1" fill="#1b1d24" />
        <rect x="8" y="59" width="30" height="2.5" rx="1" fill="#8b877f" />
        <rect x="8" y="64" width="26" height="2.5" rx="1" fill="#8b877f" />
        <rect x="8" y="12" width="30" height="4" rx="2" fill="#e6e2da" />
      </g>

      <g class="cb-site" style="--i:2" transform={`translate(${thumbX(2)} 0)`}>
        <rect width="116" height="80" rx="8" fill="#e8e7e3" />
        <rect x="36" y="9" width="44" height="6" rx="3" fill="#d4d3cf" />
        <rect x="24" y="32" width="68" height="8" rx="1.5" fill="#1b1d24" />
        <rect x="32" y="45" width="52" height="3" rx="1.5" fill="#8d8f96" />
        <rect x="30.5" y="56.5" width="26" height="10" rx="5" fill="none" stroke="#1b1d24" />
        <rect x="60" y="56" width="27" height="11" rx="5.5" fill="#2860f0" />
      </g>

      <!-- the spotlight: one ring and one "View site" pill, moving across the three -->
      {[0, 1, 2].map((i) => (
        <g class="cb-spot" style={`--i:${i}`} transform={`translate(${thumbX(i)} 0)`}>
          <rect x="-1" y="-1" width="118" height="82" rx="9" class="cb-ring" />
          <g transform="translate(66 6)">
            <rect width="44" height="14" rx="7" class="f-ink" />
            <text x="22" y="9.8" class="t t-dark" style="font-size:7px" text-anchor="middle">View site ↗</text>
          </g>
        </g>
      ))}
    </g>
  </Panel>
</svg>

<style>
  .pv-corpo {
    --loop: 7.5s;
  }

  .cb-chip {
    opacity: 0;
    animation: cb-chip var(--loop) var(--ease-out) infinite;
    animation-delay: calc(var(--i) * 1.5s);
  }

  @keyframes cb-chip {
    0% { opacity: 0; }
    3%, 18% { opacity: 1; }
    21%, 100% { opacity: 0; }
  }

  .cb-ring {
    fill: none;
    stroke: var(--blue-hi);
    stroke-width: 1.5;
  }

  .cb-spot {
    opacity: 0;
    animation: cb-spot 4.5s var(--ease-out) infinite;
    animation-delay: calc(var(--i) * 1.5s);
  }

  @keyframes cb-spot {
    0%, 33.4%, 100% { opacity: 0; }
    6%, 30% { opacity: 1; }
  }
</style>
