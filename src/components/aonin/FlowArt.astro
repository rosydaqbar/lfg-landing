---
// How Aonin works, after docs/images/how-it-works.svg in the app's dark theme: three audio
// senders stream over the LAN to one listener, which mixes them into one output.
const senders = [
  { y: 24, name: 'Studio MacBook Pro', sub: 'Audio sender · macOS', chips: [['System audio', true], ['Mic', true]], kind: 'mac', level: 7 },
  { y: 144, name: 'Work Laptop', sub: 'Audio sender · Windows', chips: [['System audio', true], ['Mic off', false]], kind: 'pc', level: 9 },
  { y: 264, name: 'Office MacBook', sub: 'Audio sender · macOS', chips: [['System audio', true], ['Mic off', false]], kind: 'mac', level: 5 },
] as const;
const LX = 640; // listener card left edge
const paths = senders.map((s, i) => {
  const y = s.y + 50;
  const ty = 166 + i * 24;
  return `M336 ${y} C 470 ${y}, 506 ${ty}, ${LX - 6} ${ty}`;
});
const wave = (x: number, y: number, w: number, seed: number) => {
  let d = '';
  for (let i = 0; i <= 38; i++) {
    const px = x + (w / 38) * i;
    const py = y + Math.sin(i * 0.55 + seed) * 3.6 * Math.sin((i / 38) * Math.PI) + Math.sin(i * 1.7 + seed) * 1.2;
    d += `${i ? 'L' : 'M'}${px.toFixed(1)} ${py.toFixed(1)}`;
  }
  return d;
};
---
<svg class="ao-flow" viewBox="0 0 960 388" role="img" aria-label="Diagram: three computers send their audio over your Wi-Fi or Ethernet, straight from device to device, to one listener, which mixes it and plays it on one pair of headphones. A packet lost on Wi-Fi turns red and is rebuilt from the next one.">
  <defs>
    <pattern id="flow-dots" width="20" height="20" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1.1" fill="#2e2e2e" />
    </pattern>
    <linearGradient id="flow-screen" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1c1c1c" /><stop offset="1" stop-color="#121212" />
    </linearGradient>
  </defs>

  <!-- the network floor -->
  <rect x="352" y="66" width="272" height="266" rx="22" fill="url(#flow-dots)" />
  <text x="488" y="30" class="f f-net" text-anchor="middle">Your Wi-Fi or Ethernet</text>
  <text x="488" y="50" class="f f-label" text-anchor="middle">UDP, straight from device to device</text>

  <!-- audio senders -->
  {senders.map((s, i) => (
    <g>
      <rect x="0.5" y={s.y + 0.5} width="330" height="99" rx="14" fill="#212121" stroke="#353535" />
      {s.kind === 'mac' ? (
        <g>
          <rect x="20" y={s.y + 22} width="76" height="48" rx="5" fill="#0e0e0e" stroke="#484847" />
          <rect x="24" y={s.y + 26} width="68" height="40" rx="2.5" fill="url(#flow-screen)" />
          <path d={wave(30, s.y + 46, 56, i * 2.1)} class="f-wave" />
          <path d={`M12 ${s.y + 72} h92 l-5 6 h-82 z`} fill="#484847" />
        </g>
      ) : (
        <g>
          <rect x="20" y={s.y + 20} width="76" height="50" rx="4" fill="#0e0e0e" stroke="#484847" />
          <rect x="24" y={s.y + 24} width="68" height="42" rx="2" fill="#1b2633" />
          <rect x="31" y={s.y + 31} width="54" height="28" rx="3" fill="#2c2c2c" />
          <rect x="31" y={s.y + 31} width="54" height="6" rx="3" fill="#353535" />
          <path d={`M38 ${s.y + 43} l7 4.5 -7 4.5z`} fill="#e9e9e7" />
          <rect x="50" y={s.y + 46} width="29" height="2.5" rx="1.25" fill="#484847" />
          <rect x="50" y={s.y + 46} width="13" height="2.5" rx="1.25" fill="#f07a3a" class="f-progress" />
          <rect x="14" y={s.y + 72} width="88" height="7" rx="2.5" fill="#484847" />
        </g>
      )}
      <text x="118" y={s.y + 34} class="f f-name">{s.name}</text>
      <text x="118" y={s.y + 52} class="f f-label">{s.sub}</text>
      {s.chips.map(([label, on], j) => {
        const w = label.length * 6.1 + 22;
        const x = 118 + (j === 0 ? 0 : 98);
        return (
          <g>
            <rect x={x + 0.5} y={s.y + 64.5} width={w} height="21" rx="10.5" fill={on ? '#131313' : '#2c2c2c'} stroke={on ? '#131313' : '#484847'} />
            <text x={x + w / 2 + 0.5} y={s.y + 79} class={on ? 'f f-chip' : 'f f-chip f-off'} text-anchor="middle">{label}</text>
          </g>
        );
      })}
      <circle cx="330.5" cy={s.y + 50} r="5" fill="#212121" stroke="#484847" stroke-width="1.5" />
    </g>
  ))}

  <!-- paths and packets: a script moves them, and now and then one is lost on Wi-Fi,
       turns red, gets repaired and carries on -->
  {paths.map((d, i) => <path d={d} class="f-path" data-flow-path={i} />)}
  {paths.map((d, i) =>
    [0, 1, 2].map((k) => (
      <g class="pkt" data-path={i} data-off={(k / 3 + i * 0.13) % 1}>
        <rect x="-32" y="-6" width="14" height="12" rx="3" class="pkt-copy" />
        <rect x="-17" y="-6" width="20" height="12" rx="3" class="pkt-main" />
      </g>
    )),
  )}

  <!-- the floating status tag for the packet in trouble -->
  <g class="lost-tag" aria-hidden="true">
    <path class="tag-tip" d="M-6 15 L0 9 L6 15" />
    <rect class="tag-box" x="-104" y="14.5" width="208" height="46" rx="10" />
    <circle class="tag-dot" cx="-88" cy="31" r="4" />
    <text class="tag-title" x="-78" y="35">Lost on Wi-Fi</text>
    <text class="tag-sub" x="-88" y="51">Rebuilding from the next packet…</text>
  </g>

  <!-- listener -->
  <rect x={LX + 0.5} y="64.5" width="319" height="259" rx="16" fill="#212121" stroke="#484847" />
  <rect x={LX + 1} y="65" width="318" height="44" rx="15.5" fill="#131313" />
  <rect x={LX + 1} y="90" width="318" height="19" fill="#131313" />
  <text x={LX + 18} y="92" class="f f-name">PC-Studio</text>
  <circle cx={LX + 220} cy="87.5" r="4" fill="#f07a3a" />
  <text x={LX + 302} y="91.5" class="f f-label f-strip" text-anchor="end">Listening</text>
  {[0, 1, 2].map((i) => (
    <circle cx={LX - 0.5} cy={166 + i * 24} r="5" fill="#212121" stroke="#484847" stroke-width="1.5" />
  ))}
  <text x={LX + 18} y="138" class="f f-label">Mixing 3 audio senders</text>
  <g data-meter data-level="0.7">
    {Array.from({ length: 16 }, (_, j) => (
      <circle cx={LX + 24 + j * 12.6} cy="160" r="3.6" class={j < 11 ? 'hole on' : 'hole'} />
    ))}
  </g>
  <path d={`M${LX + 18} 186.5 H ${LX + 302}`} stroke="#353535" />
  <text x={LX + 18} y="210" class="f f-label">Playing to</text>
  <text x={LX + 18} y="230" class="f f-name">Headphones</text>
  <text x={LX + 302} y="230" class="f f-label" text-anchor="end">15–30 ms</text>

  <!-- headphones -->
  <g transform={`translate(${LX + 160} 276)`} class="f-phones">
    <path d="M-30 10 v-8 a30 30 0 0 1 60 0 v8" />
    <rect x="-36" y="4" width="13" height="26" rx="5" />
    <rect x="23" y="4" width="13" height="26" rx="5" />
  </g>
</svg>

<style>
  .ao-flow {
    display: block;
    width: 100%;
    height: auto;
    font-family: 'Hanken Grotesk Variable', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-feature-settings: 'tnum' 1;
    overflow: visible;
  }

  .ao-flow :global(.f) { fill: #e9e9e7; }
  .ao-flow :global(.f-net) { font-size: 15px; font-weight: 650; }
  .ao-flow :global(.f-label) { fill: #a2a2a0; font-size: 12px; letter-spacing: 0.03em; }
  .ao-flow :global(.f-strip) { fill: #999997; }
  .ao-flow :global(.f-name) { font-size: 14px; font-weight: 600; }
  .ao-flow :global(.f-small) { font-size: 12px; }
  .ao-flow :global(.f-strong) { font-weight: 650; }
  .ao-flow :global(.f-dim) { fill: #a2a2a0; }
  .ao-flow :global(.f-chip) { font-size: 11px; letter-spacing: 0.03em; }
  .ao-flow :global(.f-off) { fill: #a2a2a0; }

  .ao-flow :global(.f-wave) {
    fill: none;
    stroke: #f07a3a;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ao-flow :global(.f-path) {
    fill: none;
    stroke: #484847;
    stroke-width: 2;
    stroke-dasharray: 1 7;
    stroke-linecap: round;
  }

  .ao-flow :global(.pkt-main),
  .ao-flow :global(.pkt-copy) {
    fill: #f07a3a;
    transition: fill 160ms ease;
  }

  .ao-flow :global(.pkt-copy) { opacity: 0.35; }
  .ao-flow :global(.pkt.lost .pkt-main),
  .ao-flow :global(.pkt.lost .pkt-copy) { fill: #e5584b; }
  .ao-flow :global(.pkt.lost .pkt-copy) { opacity: 0.5; }
  .ao-flow :global(.pkt.fixed .pkt-copy) { fill: #9bbe55; opacity: 1; }
  .ao-flow :global(.pkt.fixed .pkt-main) { fill: #9bbe55; }

  .ao-flow :global(.lost-tag) {
    opacity: 0;
    transition: opacity 200ms ease;
    pointer-events: none;
  }

  .ao-flow :global(.lost-tag.on) { opacity: 1; }
  .ao-flow :global(.tag-box) { fill: #1b1b1b; stroke: #e5584b; transition: stroke 160ms ease; }
  .ao-flow :global(.tag-tip) { fill: #1b1b1b; stroke: #e5584b; stroke-linejoin: round; transition: stroke 160ms ease; }
  .ao-flow :global(.tag-dot) { fill: #e5584b; transition: fill 160ms ease; }
  .ao-flow :global(.tag-title) { fill: #e5584b; font-size: 12px; font-weight: 650; letter-spacing: 0.02em; }
  .ao-flow :global(.tag-sub) { fill: #a2a2a0; font-size: 11px; letter-spacing: 0.02em; }
  .ao-flow :global(.lost-tag.fixed .tag-box),
  .ao-flow :global(.lost-tag.fixed .tag-tip) { stroke: #9bbe55; }
  .ao-flow :global(.lost-tag.fixed .tag-dot) { fill: #9bbe55; }
  .ao-flow :global(.lost-tag.fixed .tag-title) { fill: #9bbe55; }

  .ao-flow :global(.f-phones) {
    fill: none;
    stroke: #e9e9e7;
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .ao-flow :global(.f-phones rect) { fill: #2c2c2c; }

  .ao-flow :global(.hole) { fill: #4a4a4a; transition: fill 90ms linear; }
  .ao-flow :global(.hole.on) { fill: #e9e9e7; }
  .ao-flow :global(.hole.flash) { fill: #f07a3a; transition: none; }
</style>

<script>
  /* Packets ride the paths. Every few seconds one is "lost on Wi-Fi": it turns red and
     stalls, then the next packet's copy rebuilds it (green), and it carries on in orange. */
  const svg = document.querySelector<SVGSVGElement>('.ao-flow');
  if (svg) {
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const paths = Array.from(svg.querySelectorAll<SVGPathElement>('[data-flow-path]'));
    const lens = paths.map((p) => p.getTotalLength());
    const tag = svg.querySelector<SVGGElement>('.lost-tag')!;
    const tagTitle = tag.querySelector<SVGTextElement>('.tag-title')!;
    const tagSub = tag.querySelector<SVGTextElement>('.tag-sub')!;
    const tagTip = tag.querySelector<SVGPathElement>('.tag-tip')!;
    const pkts = Array.from(svg.querySelectorAll<SVGGElement>('.pkt')).map((el) => ({
      el,
      path: Number(el.dataset.path),
      t: Number(el.dataset.off),
    }));
    const dur = (i: number) => 2600 + i * 350;
    // the whole stream on a line waits while its lost packet is repaired, so nothing overtakes it
    const pathSpeed = paths.map(() => 1);

    const place = (p: (typeof pkts)[number]) => {
      const path = paths[p.path];
      const L = lens[p.path];
      const at = Math.min(L, p.t * L);
      const a = path.getPointAtLength(at);
      const b = path.getPointAtLength(Math.min(L, at + 1));
      const deg = (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI;
      p.el.setAttribute('transform', `translate(${a.x.toFixed(1)} ${a.y.toFixed(1)}) rotate(${deg.toFixed(1)})`);
      // fade in at the sender, out at the listener
      p.el.style.opacity = String(Math.min(1, p.t * 12, (1 - p.t) * 12));
      return a;
    };

    pkts.forEach(place);

    if (!calm) {
      let visible = true;
      new IntersectionObserver((e) => (visible = e[0].isIntersecting)).observe(svg);

      let victim: (typeof pkts)[number] | null = null;
      let phase: 'lost' | 'fixed' | null = null;
      let phaseAt = 0;
      let nextAt = performance.now() + 1500;
      let last = performance.now();

      const tick = (now: number) => {
        const dt = Math.min(64, now - last);
        last = now;
        if (visible && !document.hidden) {
          // start an incident on a packet that's mid-flight
          if (!victim && now > nextAt) {
            const pool = pkts.filter((p) => p.t > 0.28 && p.t < 0.5);
            if (pool.length) {
              victim = pool[Math.floor(Math.random() * pool.length)];
              phase = 'lost';
              phaseAt = now;
              pathSpeed[victim.path] = 0.12;
              victim.el.classList.add('lost');
              tagTitle.textContent = 'Lost on Wi-Fi';
              tagSub.textContent = 'Rebuilding from the next packet…';
              tag.classList.remove('fixed');
              tag.classList.add('on');
            }
          }
          if (victim && phase === 'lost' && now - phaseAt > 1100) {
            phase = 'fixed';
            phaseAt = now;
            victim.el.classList.remove('lost');
            victim.el.classList.add('fixed');
            tagTitle.textContent = 'Repaired';
            tagSub.textContent = 'Got it back in time. Nothing lost.';
            tag.classList.add('fixed');
          }
          if (victim && phase === 'fixed' && now - phaseAt > 800) {
            victim.el.classList.remove('fixed');
            pathSpeed[victim.path] = 1;
            tag.classList.remove('on');
            victim = null;
            phase = null;
            nextAt = now + 2500 + Math.random() * 3500;
          }
          if (victim && phase === 'fixed') pathSpeed[victim.path] = Math.min(1, pathSpeed[victim.path] + dt / 600);

          for (const p of pkts) {
            p.t += (dt / dur(p.path)) * pathSpeed[p.path];
            if (p.t >= 1) p.t -= 1;
            const pt = place(p);
            if (p === victim) {
              // the card stays inside the network area; its arrow keeps pointing at the packet
              const cx = Math.max(460, Math.min(520, pt.x));
              tag.setAttribute('transform', `translate(${cx.toFixed(1)} ${pt.y.toFixed(1)})`);
              tagTip.setAttribute('transform', `translate(${(pt.x - cx).toFixed(1)} 0)`);
            }
          }
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }
</script>
