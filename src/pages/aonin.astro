---
import '@fontsource-variable/hanken-grotesk';
import Base from '../layouts/Base.astro';
import WindowArt from '../components/aonin/WindowArt.astro';
import PopoverArt from '../components/aonin/PopoverArt.astro';
import FlowArt from '../components/aonin/FlowArt.astro';
import UseScene from '../components/aonin/UseScene.astro';
import appIcon from '../assets/aonin/app-icon.svg?raw';

// Every claim below comes from the Aonin README / app. Nothing invented.
const steps = [
  {
    n: '01',
    title: 'Choose your listener',
    body: 'Pick the computer connected to your headphones or speakers.',
  },
  {
    n: '02',
    title: 'Connect audio senders',
    body: 'Aonin finds your computers automatically. Connect them to share their audio.',
  },
  {
    n: '03',
    title: 'Mix your audio',
    body: 'Adjust each computer’s volume or mute it. Audio senders can hear the listener, too.',
  },
];

const quality = [
  { name: 'Highest', detail: '24-bit · 48 kHz, uncompressed', rate: '2.3 Mbps', on: true },
  { name: 'CD', detail: '16-bit · 48 kHz, CD quality', rate: '1.5 Mbps' },
  { name: 'Balanced', detail: 'Opus, for busy Wi-Fi', rate: '256 kbps' },
  { name: 'Saver', detail: 'Opus, for weak Wi-Fi', rate: '96 kbps' },
];

// Three setups Aonin is for. Each only uses what the app does today.
const uses = [
  {
    kind: 'desk',
    who: 'You, at your desk',
    title: 'PC and MacBook side by side',
    body: 'Watch something on your MacBook and hear it through the headset connected to your PC.',
  },
  {
    kind: 'work',
    who: 'Working from home',
    title: 'Work laptop next to a gaming PC',
    body: 'Hear calls and notifications from your work laptop without switching headsets.',
  },
  {
    kind: 'party',
    who: 'Game night',
    title: 'Everyone’s music, one set of speakers',
    body: 'Let friends play music from their laptops through your speakers.',
  },
] as const;

const done = [
  { text: 'Stream audio over your local network' },
  { text: 'Share system audio or microphone audio' },
  { text: 'Automatically find and reconnect your computers' },
  { text: 'Adjust volume, mute, and see audio levels for each computer' },
];

// Pricing. Facts from the Aonin README and the app's Pro screen.
const RELEASES = 'https://github.com/rosydaqbar/aonin/releases/latest';
const DISCORD = 'https://discord.gg/2cQBYaNHjC';
const freePlan = [
  'Stream system audio and microphone audio',
  'High-quality audio with an option for slower networks',
  'Adjust volume, mute, and see audio levels for each computer',
  'Hear the listener’s audio from another computer',
  'Join private listeners with a code',
];
const proPlan = [
  { title: 'Private listeners', detail: 'Choose who can connect using a join code. Audio is encrypted.' },
  { title: 'Make listener', detail: 'Switch which computer plays the audio without reconnecting everyone.' },
  { title: 'Android and iOS apps', detail: 'Send or listen to audio from your phone.', soon: true },
];

const next = [
  'Android and iOS support',
  'A refreshed Mac app',
  'Easier installation on Windows and macOS',
];
---
<Base
  title="Aonin · Hear every computer through one pair of headphones"
  description="Stream audio from multiple computers to one listener. Uncompressed 24-bit/48 kHz audio over your local network. Free for Windows and macOS."
>
  <div class="page">
    <!-- Hero -->
    <header class="stage">
      <span class="icon" set:html={appIcon} aria-hidden="true" />

      <h1>Aonin</h1>
      <p class="tagline">Hear every computer on your desk through one pair of headphones.</p>
      <p class="meta">Windows &amp; macOS · local network only</p>

      <div class="get">
        <a class="btn" href="#pricing" data-umami-event="try_now_click">
          Try now
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3.5v9 M4.5 9 8 12.5 11.5 9" /></svg>
        </a>
        <p class="dl-note" data-dl-note>Free download for Windows and macOS</p>
      </div>

      <figure class="preview" data-ao-art>
        <div class="win"><WindowArt /></div>
        <div class="pop"><PopoverArt /></div>
      </figure>
    </header>

    <main>
      <!-- How it works -->
      <section class="sec" aria-labelledby="how-h">
        <div class="wrap">
          <div class="head" data-reveal="head">
            <p class="eyebrow">How it works</p>
            <h2 id="how-h">Hear all your computers together.</h2>
            <p class="lede">Install Aonin on each computer. Choose one as the listener and connect the others to it.</p>
          </div>

          <div class="flowcard" data-reveal="rise">
            <div class="flowscroll"><FlowArt /></div>
          </div>

          <ol class="steps" data-reveal="rise" data-reveal-group>
            {steps.map((s) => (
              <li>
                <span class="num">{s.n}</span>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- Features -->
      <section class="sec" aria-labelledby="feat-h">
        <div class="wrap">
          <div class="head" data-reveal="head">
            <p class="eyebrow">Built for listening</p>
            <h2 id="feat-h">Good sound, simple setup.</h2>
            <p class="lede">Listen to multiple computers together without extra equipment or complicated setup.</p>
          </div>

          <div class="bento" data-reveal="rise" data-reveal-group>
            <article class="card b-quality">
              <div class="txt">
                <p class="stat">Uncompressed</p>
                <h3>High-quality audio</h3>
                <p>Enjoy uncompressed audio by default, or choose a lighter option for slower networks.</p>
              </div>
              <div class="vig">
                <div class="ui">
                  <p class="ui-head">Quality <small>For audio this device sends</small></p>
                  {quality.map((q) => (
                    <div class="ui-radio" data-on={q.on ? '' : undefined}>
                      <i></i>
                      <span class="ui-who"><b>{q.name}</b><small>{q.detail}</small></span>
                      <small class="r">{q.rate}</small>
                    </div>
                  ))}
                </div>
              </div>
            </article>

            <article class="card b-time">
              <div class="vig">
                <div class="pk-stage">
                  <div class="packets" aria-hidden="true">
                    <span><i></i><b></b></span>
                    <span class="lost"><i></i><b></b></span>
                    <span class="fixed"><i></i><b></b></span>
                    <span><i></i><b></b></span>
                  </div>
                  <div class="pk-keys" aria-hidden="true">
                    <small class="k-lost">Lost on Wi-Fi</small>
                    <small class="k-fixed">Rebuilt</small>
                  </div>
                </div>
              </div>
              <p class="stat">15–30 ms</p>
              <h3>Listen over Wi-Fi</h3>
              <p>Stream audio wirelessly with very little delay, even when your Wi-Fi isn’t perfect.</p>
            </article>

            <article class="card">
              <div class="vig">
                <div class="ui">
                  <p class="ui-head">Listeners on this network</p>
                  <div class="ui-row">
                    <i class="dot green"></i>
                    <span class="ui-who"><b>PC-Studio</b><small>2 audio senders</small></span>
                    <span class="ui-btn">Connect</span>
                  </div>
                  <div class="ui-row">
                    <i class="dot green"></i>
                    <span class="ui-who"><b>Living Room PC</b><small>1 audio sender</small></span>
                    <span class="ui-btn">Connect</span>
                  </div>
                </div>
              </div>
              <h3>Your network only</h3>
              <p>Audio stays on your local network. No servers or accounts needed.</p>
            </article>

            <article class="card">
              <div class="vig">
                <div class="ui">
                  <div class="ui-switch">
                    <span class="ui-ico"><svg viewBox="0 0 14 14"><path d="M1.5 2h11v7.5h-11z M5 12.5h4 M7 9.5v3" /></svg></span>
                    <span class="ui-who"><b>System audio</b><small>Everything this device plays</small></span>
                    <span class="ui-track on"><i></i></span>
                  </div>
                  <div class="ui-switch">
                    <span class="ui-ico"><svg viewBox="0 0 14 14"><path d="M5 1.5h4v6.5a2 2 0 0 1-4 0z M2.5 7a4.5 4.5 0 0 0 9 0 M7 11.5v2" /></svg></span>
                    <span class="ui-who"><b>Microphone</b><small>USB Microphone</small></span>
                    <span class="ui-track on"><i></i></span>
                  </div>
                </div>
              </div>
              <h3>No drivers</h3>
              <p>Works on Windows and macOS without installing extra audio drivers.</p>
            </article>

            <article class="card">
              <div class="vig">
                <div class="ui">
                  <p class="ui-title">Join a private listener</p>
                  <small class="ui-hint">Type the code shown on the listener.</small>
                  <span class="ui-field">K7Q 4MZ<i aria-hidden="true"></i></span>
                  <span class="ui-actions"><span class="ui-btn quiet">Cancel</span><span class="ui-btn primary">Join</span></span>
                </div>
              </div>
              <h3 class="with-tag">Private listeners <span class="pro-tag">Pro</span></h3>
              <p>Control who connects with a join code. Your audio is encrypted.</p>
            </article>
          </div>
        </div>
      </section>

      <!-- Who it's for -->
      <section class="sec" aria-labelledby="uc-h">
        <div class="wrap">
          <div class="head" data-reveal="head">
            <p class="eyebrow">Who it’s for</p>
            <h2 id="uc-h">For anyone using more than one computer.</h2>
            <p class="lede">Here are a few ways you can use Aonin.</p>
          </div>

          <div class="uses" data-reveal="rise" data-reveal-group>
            {uses.map((u, i) => (
              <article class={i === 0 ? 'card uc uc-lead' : 'card uc'}>
                <div class="txt">
                  <p class="who">{u.who}</p>
                  <h3>{u.title}</h3>
                  <p>{u.body}</p>
                </div>
                <div class="vig scene"><UseScene kind={u.kind} /></div>
              </article>
            ))}
          </div>

          <ul class="more" data-reveal="rise" data-reveal-group>
            <li>Laptop on the couch, speakers at the desk</li>
            <li>A spare PC across the room</li>
            <li>Hear the listener back</li>
            <li class="etc">and more</li>
          </ul>
        </div>
      </section>

      <!-- Pricing -->
      <section class="sec" id="pricing" aria-labelledby="price-h">
        <div class="wrap">
          <div class="head" data-reveal="head">
            <p class="eyebrow">Pricing</p>
            <h2 id="price-h">Start free, upgrade when you need more.</h2>
            <p class="lede">Stream audio between your computers for free. Pro adds more control over who connects and which computer plays the audio.</p>
          </div>

          <div class="plans" data-reveal="rise" data-reveal-group>
            <article class="card plan">
              <h3>Free</h3>
              <p class="price">$0</p>
              <p class="plan-sub">Listen to multiple computers through one pair of headphones or speakers.</p>
              <a class="btn alt" href={RELEASES} data-download="pricing">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.5v8 M4.5 7 8 10.5 11.5 7 M3 13.5h10" /></svg>
                Try for free
              </a>
              <ul class="feats">
                {freePlan.map((f) => (
                  <li><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M2.5 7.5 5.5 10.5 11.5 3.5" /></svg>{f}</li>
                ))}
              </ul>
            </article>

            <article class="card plan pro">
              <span class="pro-tag xl">Pro</span>
              <h3 class="sr-only">Aonin Pro</h3>
              <p class="price">$5 <span>One-time purchase</span></p>
              <p class="plan-sub">One license covers 2 computers for life, with one year of Pro updates.</p>
              <div class="buy">
                <button class="btn" type="button" aria-disabled="true" data-purchase>Purchase</button>
                <p class="buy-note">Coming soon</p>
              </div>
              <p class="feats-head">Also included with Pro:</p>
              <ul class="feats pro-feats">
                {proPlan.map((f) => (
                  <li>
                    <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M2.5 7.5 5.5 10.5 11.5 3.5" /></svg>
                    <span><b>{f.title}{f.soon && <em>Coming soon</em>}</b><small>{f.detail}</small></span>
                  </li>
                ))}
              </ul>
              <p class="plan-note">Activate Pro on the listener. Other computers can connect without Pro.</p>
            </article>
          </div>
        </div>
      </section>

      <!-- Status -->
      <section class="sec" aria-labelledby="status-h">
        <div class="wrap">
          <div class="head" data-reveal="head">
            <p class="eyebrow">Status</p>
            <h2 id="status-h">Aonin is in early development.</h2>
            <p class="lede">You can already stream audio between Windows and macOS computers on the same network.</p>
          </div>

          <div class="grid two status" data-reveal="rise" data-reveal-group>
            <div class="card list">
              <h3>Working today</h3>
              <ul>
                {done.map((d) => (
                  <li><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M2.5 7.5 5.5 10.5 11.5 3.5" /></svg><span>{d.text}{d.pro && <span class="pro-tag">Pro</span>}</span></li>
                ))}
              </ul>
            </div>
            <div class="card list">
              <h3>Coming next</h3>
              <ul class="next">
                {next.map((n) => (
                  <li><svg viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="2.5" /></svg>{n}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Closing -->
      <section class="end" data-reveal="rise">
        <span class="icon sm" set:html={appIcon} aria-hidden="true" />
        <h2>Try Aonin now.</h2>
        <p>Free for Windows and macOS. Aonin is free software licensed under GNU GPL v3.</p>
        <div class="end-actions">
          <a class="btn" href={RELEASES} data-download="closing">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.5v8 M4.5 7 8 10.5 11.5 7 M3 13.5h10" /></svg>
            Try for free
          </a>
        </div>
      </section>
    </main>

    <!-- After a download starts -->
    <dialog class="thanks" data-thanks aria-labelledby="thanks-h">
      <button class="x" type="button" data-close aria-label="Close">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8 M12 4l-8 8" /></svg>
      </button>
      <span class="icon xs" set:html={appIcon} aria-hidden="true" />
      <h2 id="thanks-h">Thank you for trying Aonin</h2>
      <p>Your download should start automatically. If it doesn’t, <a href={RELEASES} data-dl-direct>click here</a>.</p>
      <div class="trial">
        <span class="pro-tag lg">Pro</span>
        <p>Want to try Pro? Get a trial key on Discord.</p>
      </div>
      <a class="btn discord" href={DISCORD} target="_blank" rel="noopener" data-discord>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" stroke="none" d="M19.3 5.3A16.6 16.6 0 0 0 15.2 4l-.5 1a15.4 15.4 0 0 0-5.4 0l-.5-1a16.5 16.5 0 0 0-4.1 1.3C2.1 9.2 1.4 13 1.7 16.7a16.7 16.7 0 0 0 5 2.5l1.1-1.7a10.8 10.8 0 0 1-1.7-.8l.4-.3a11.9 11.9 0 0 0 10.2 0l.4.3a10.8 10.8 0 0 1-1.7.8l1.1 1.7a16.6 16.6 0 0 0 5-2.5c.4-4.3-.7-8-3-11.4ZM8.7 14.4c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Zm6.6 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Z" /></svg>
        Get a trial key on Discord
      </a>
      <details class="install" data-install>
        <summary>Having trouble opening the installer?</summary>
        <p><b>Windows:</b> If SmartScreen blocks Aonin, select More info, then Run anyway.</p>
        <p><b>macOS:</b> Drag Aonin into Applications. If macOS blocks it, right-click the app and select Open.</p>
      </details>
    </dialog>

    <footer class="foot">© 2026 LFG.ink</footer>
  </div>
</Base>

<style>
  /* Aonin's own language: Braun charcoal housing, graphite, one orange accent, Hanken Grotesk. */
  :global(html),
  :global(body) {
    background: #131313;
  }

  .page {
    --housing: #212121;
    --recess: #191919;
    --raised: #2c2c2c;
    --strip: #131313;
    --ink: #e9e9e7;
    --ink-2: #a2a2a0;
    --ink-3: #7a7a78;
    --line: #353535;
    --line-strong: #484847;
    --card: #1a1a1a;
    --card-line: #262626;
    --orange: #f07a3a;
    --orange-ink: #f39260;
    --green: #9bbe55;
    --red: #e5584b;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);

    min-height: 100svh;
    overflow-x: clip;
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(60% 900px at 50% 0%, rgb(255 255 255 / 0.05), transparent 70%),
      var(--strip);
    color: var(--ink);
    font-family: 'Hanken Grotesk Variable', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-feature-settings: 'tnum' 1;
  }

  .page ::selection {
    background: var(--orange);
    color: #fff;
  }

  .page :focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 3px;
  }

  /* ---------- Hero (centered) ---------- */
  .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(72px, 12vh, 128px) 20px 0;
  }

  .stage > :not(.preview) {
    animation: rise 0.9s var(--ease) both;
  }

  .stage > :nth-child(2) { animation-delay: 0.06s; }
  .stage > :nth-child(3) { animation-delay: 0.12s; }
  .stage > :nth-child(4) { animation-delay: 0.18s; }
  .stage > :nth-child(5) { animation-delay: 0.24s; }
  .stage > :nth-child(6) { animation-delay: 0.3s; }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  .icon {
    display: block;
    width: clamp(72px, 9vw, 96px);
    filter: drop-shadow(0 16px 28px rgb(0 0 0 / 0.55));
  }

  .icon.sm {
    width: 64px;
    margin-inline: auto;
  }

  .icon :global(svg) {
    width: 100%;
    height: auto;
  }

  @keyframes breathe {
    50% { opacity: 0.3; }
  }

  h1 {
    margin-top: 28px;
    font-size: clamp(3.5rem, 8vw, 5.75rem);
    line-height: 0.95;
    font-weight: 650;
    letter-spacing: -0.045em;
  }

  .tagline {
    margin-top: 18px;
    max-width: 22ch;
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    line-height: 1.25;
    font-weight: 450;
    letter-spacing: -0.015em;
    color: var(--ink-2);
    text-wrap: balance;
  }

  .meta {
    margin-top: 14px;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }

  /* Aonin's pill button: the one primary action, in orange */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 34px;
    height: 40px;
    padding: 0 20px 0 14px;
    border-radius: 20px;
    background: var(--orange);
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: background 120ms var(--ease), transform 200ms var(--ease);
  }

  .btn svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .btn:hover {
    background: var(--orange-ink);
    transform: translateY(-1px);
  }

  .btn:active {
    transform: none;
  }

  /* Secondary: the app's raised grey pill */
  .btn.alt {
    background: var(--raised);
    border: 1px solid var(--line-strong);
    color: var(--ink);
    font-weight: 500;
  }

  .btn.alt:hover {
    background: #333;
  }

  .btn[disabled],
  .btn[aria-disabled="true"] {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none;
    background: var(--orange);
  }

  /* hero download */
  .get {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .dl-note {
    margin-top: 12px;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }

  /* The app's Pro badge (theme.css .pro-tag): brushed metal, light ink */
  .page :global(.pro-tag) {
    display: inline-flex;
    align-items: center;
    flex: none;
    height: 16px;
    padding: 0 6px;
    border-radius: 4px;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1;
    color: #6b6b67;
    border: 1px solid #8a8a86;
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.07) 0 1px, rgb(0 0 0 / 0.04) 1px 2px),
      linear-gradient(180deg, #fafaf8 0%, #d6d6d2 42%, #b4b4af 56%, #e2e2de 100%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      inset 0 -1px 0 rgb(0 0 0 / 0.18),
      0 1px 1.5px rgb(0 0 0 / 0.35);
    text-shadow:
      0 1px 0 rgb(255 255 255 / 0.85),
      0 -1px 0 rgb(0 0 0 / 0.28);
  }

  .page :global(.pro-tag.lg) { height: 18px; padding: 0 8px; border-radius: 5px; font-size: 10px; border-color: #7d7d79; }
  .page :global(.pro-tag.xl) { height: 24px; padding: 0 10px; border-radius: 6px; font-size: 12.5px; }

  .with-tag {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* The window, with the tray popover over its right side, fading into the dark below */
  .preview {
    position: relative;
    width: min(1040px, 100%);
    margin: clamp(56px, 8vw, 88px) 0 0;
    padding-right: 6%;
    -webkit-mask-image: linear-gradient(180deg, #000 45%, rgb(0 0 0 / 0.5) 72%, transparent 96%);
    mask-image: linear-gradient(180deg, #000 45%, rgb(0 0 0 / 0.5) 72%, transparent 96%);
    animation: surface 1.3s var(--ease) 0.35s both;
  }

  /* One owner for each rounded corner: the frame clips, and its edge is drawn on top at
     the same radius, so no sliver of a second curve shows at the corners. */
  .win,
  .pop {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.9);
  }

  .win::after,
  .pop::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px #3a3a3a;
    pointer-events: none;
  }

  .pop {
    position: absolute;
    right: 0;
    top: 25%;
    width: 33%;
    border-radius: 10px;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.04) inset,
      0 30px 60px -12px rgb(0 0 0 / 0.85),
      0 0 0 1px rgb(0 0 0 / 0.5);
    animation: pop 1.1s var(--ease) 0.9s both;
  }

  @keyframes surface {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.98);
    }
  }

  /* ---------- Sections (centered column, left-aligned text) ---------- */
  main {
    flex: 1;
  }

  .wrap {
    width: min(1080px, 100% - 40px);
    margin-inline: auto;
  }

  .sec {
    padding-top: clamp(88px, 12vw, 152px);
  }

  .sec:first-child {
    padding-top: clamp(40px, 6vw, 72px);
  }

  .head {
    max-width: 720px;
    margin-bottom: clamp(32px, 4vw, 48px);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--orange);
  }

  .head h2,
  .end h2 {
    margin-top: 14px;
    font-size: clamp(2rem, 4.2vw, 3rem);
    line-height: 1.04;
    font-weight: 650;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .lede {
    margin-top: 18px;
    max-width: 56ch;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .flowcard {
    padding: clamp(20px, 3.5vw, 40px);
    border-radius: 20px;
    background: var(--card);
    border: 1px solid var(--card-line);
  }

  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 40px;
    padding: 0;
  }

  .steps .num {
    display: block;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }

  .steps h3,
  .card h3 {
    margin-top: 16px;
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .steps p,
  .card p {
    margin-top: 8px;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  /* Bento: the quality tile leads across two columns, four tiles follow */
  .bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .card.b-quality {
    grid-column: span 2;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 12px;
    padding: 12px;
  }

  .b-quality .txt {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 20px 12px 12px;
  }

  .b-quality .txt h3 {
    margin-top: 18px;
    line-height: 1.2;
    font-size: 1.375rem;
    letter-spacing: -0.02em;
  }

  .b-quality .vig {
    height: 100%;
    min-height: 300px;
  }

  .card .stat {
    padding-inline: 12px;
    margin-top: 20px;
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    line-height: 1;
    font-weight: 650;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  .card.b-quality .stat {
    font-size: clamp(1.75rem, 2.4vw, 2.125rem);
    margin-top: 0;
    padding: 0;
  }

  .stat span {
    color: var(--ink-3);
    font-weight: 400;
  }

  .b-time .stat + h3 {
    margin-top: 10px;
  }

  .b-time .vig {
    flex: 1;
    height: auto;
    min-height: 148px;
  }

  /* Cards */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .grid.two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 16px;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 12px 12px 24px;
    border-radius: 18px;
    background: var(--card);
    border: 1px solid var(--card-line);
  }

  .card > h3,
  .card > p {
    padding-inline: 12px;
  }

  /* Vignette: a small recessed stage holding a real piece of the app's UI */
  .vig {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    height: 248px;
    padding: 16px;
    border-radius: 12px;
    background:
      radial-gradient(circle at 1px 1px, #262626 1px, transparent 1.3px) 0 0 / 16px 16px,
      #151515;
    border: 1px solid #1f1f1f;
    overflow: hidden;
  }

  .vig.big {
    height: auto;
    padding: clamp(16px, 3vw, 32px);
  }

  .ui {
    width: 100%;
    max-width: 340px;
    padding: 12px 14px;
    border-radius: 10px;
    background: var(--housing);
    border: 1px solid #2e2e2e;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.4), 0 10px 28px rgb(0 0 0 / 0.35);
    font-size: 13px;
    text-align: left;
  }

  .ui small {
    font-size: 11px;
    letter-spacing: 0.03em;
    color: var(--ink-2);
  }

  .ui b {
    font-weight: 600;
  }

  .ui-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }

  .ui-head small {
    color: var(--ink-3);
  }

  .ui-title {
    font-weight: 700;
  }

  .ui-hint {
    display: block;
    margin-top: 4px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
    display: inline-block;
  }

  .dot.green { background: var(--green); }
  .dot.red { background: var(--red); }
  .red { color: var(--red) !important; }

  .ui-row {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    border-bottom: 1px solid var(--line);
  }

  .ui-row:last-child {
    border-bottom: 0;
  }

  .ui-who {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .ui-who b,
  .ui-who small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ui-btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    height: 26px;
    padding: 0 12px;
    border-radius: 13px;
    border: 1px solid var(--line-strong);
    background: var(--raised);
    font-size: 12px;
    letter-spacing: 0.03em;
  }

  .ui-btn.quiet {
    border-color: transparent;
    background: transparent;
    color: var(--ink-2);
  }

  .ui-btn.primary {
    border-color: var(--orange);
    background: var(--orange);
    color: #fff;
    font-weight: 600;
  }

  .ui-btn.strong {
    border-color: var(--ink-2);
    font-weight: 600;
  }

  .ui-actions {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
    margin-top: 12px;
  }

  /* quality radios */
  .ui-radio {
    display: grid;
    grid-template-columns: 14px 1fr auto;
    align-items: center;
    gap: 10px;
    min-height: 38px;
    border-bottom: 1px solid var(--line);
  }

  .ui-radio .ui-who small {
    font-size: 10.5px;
  }

  .ui-radio:last-child {
    border-bottom: 0;
  }

  .ui-radio i {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--ink-2);
  }

  .ui-radio[data-on] i {
    box-shadow: inset 0 0 0 4px var(--ink);
  }

  .ui-radio:not([data-on]) b {
    font-weight: 450;
  }

  .ui-radio small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ui-radio .r {
    color: var(--ink-3);
  }

  /* switches */
  .ui-switch {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    border-bottom: 1px solid var(--line);
  }

  .ui-switch:last-child {
    border-bottom: 0;
  }

  .ui-ico {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 7px;
    background: var(--recess);
    flex: none;
  }

  .ui-ico svg,
  .list svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ui-track {
    position: relative;
    width: 34px;
    height: 20px;
    border-radius: 10px;
    box-shadow: inset 0 0 0 1.5px var(--ink-2);
    flex: none;
  }

  .ui-track i {
    position: absolute;
    left: 2px;
    top: 2px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--ink-2);
  }

  .ui-track.on {
    background: var(--ink);
    box-shadow: none;
  }

  .ui-track.on i {
    background: var(--raised);
    transform: translateX(14px);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
  }

  /* join field */
  .ui-field {
    display: flex;
    align-items: center;
    height: 40px;
    margin-top: 8px;
    padding: 0 12px;
    border-radius: 8px;
    background: var(--recess);
    border: 1px solid var(--line-strong);
    font-size: 18px;
    letter-spacing: 0.08em;
  }

  .ui-field i {
    width: 1.5px;
    height: 20px;
    margin-left: 2px;
    background: var(--orange);
    animation: caret 1.1s steps(1) infinite;
  }

  @keyframes caret {
    50% { opacity: 0; }
  }

  /* send / hear chips */
  .ui-chips {
    display: grid;
    grid-template-columns: 34px 1fr;
    align-items: center;
    gap: 10px;
    padding-block: 16px;
  }

  .ui-chips span {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .ui-chips em {
    font-style: normal;
    height: 26px;
    display: inline-flex;
    align-items: center;
    padding: 0 10px;
    border-radius: 13px;
    border: 1px solid var(--line-strong);
    background: var(--raised);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }

  .ui-chips em.on {
    background: var(--strip);
    border-color: var(--strip);
    color: var(--ink);
  }

  /* packet strip */
  /* each packet: a faint copy of the previous 2 ms, then its own 2 ms (as in the app's diagram) */
  .pk-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .packets {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .packets span {
    display: flex;
    gap: 2px;
  }

  .packets i,
  .packets b {
    height: 20px;
    border-radius: 4px;
    background: var(--orange);
  }

  .packets i {
    width: 14px;
    opacity: 0.35;
  }

  .packets b {
    width: 24px;
  }

  .packets .lost i,
  .packets .lost b {
    opacity: 1;
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--red);
  }

  .packets .lost b {
    background:
      linear-gradient(45deg, transparent 44%, var(--red) 44% 56%, transparent 56%) center / 10px 10px no-repeat,
      linear-gradient(-45deg, transparent 44%, var(--red) 44% 56%, transparent 56%) center / 10px 10px no-repeat;
  }

  .packets .fixed i {
    opacity: 1;
    background: var(--green);
  }

  .pk-keys {
    display: flex;
    gap: 16px;
    margin-top: 14px;
  }

  .pk-keys small {
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    letter-spacing: 0.03em;
    color: var(--ink-2);
  }

  .pk-keys small::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 2px;
  }

  .k-lost::before { box-shadow: inset 0 0 0 1.5px var(--red); }
  .k-fixed::before { background: var(--green); }

  .pk-note {
    margin-top: 22px;
    font-size: 12px;
    letter-spacing: 0.03em;
    color: var(--ink-2);
    text-align: center;
  }

  .pk-note b {
    color: var(--ink);
    font-weight: 650;
  }

  /* connection health */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  .split .head {
    margin-bottom: 0;
  }

  .legend {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px 18px;
    margin-top: 28px;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .legend dt {
    font-weight: 600;
  }

  .legend dd {
    color: var(--ink-2);
  }

  .ui-table {
    max-width: none;
    padding: 14px 16px 6px;
  }

  .ui-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .ui-table th {
    padding: 8px 6px;
    border-bottom: 1px solid var(--line);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-align: left;
    color: var(--ink-2);
  }

  .ui-table td {
    padding: 12px 6px;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }

  .ui-table tr:last-child td {
    border-bottom: 0;
  }

  .ui-table td:first-child,
  .ui-table th:first-child {
    width: 14px;
    padding-left: 0;
  }

  .ui-table .nm {
    font-weight: 600;
    white-space: nowrap;
  }

  .ui-table .r {
    text-align: right;
    white-space: nowrap;
  }

  .ui-table td small {
    display: block;
    color: var(--ink-3);
  }

  .ui-table td.bad {
    color: var(--red);
    font-weight: 600;
  }

  /* use cases: the lead scene runs full width, the other two share a row */
  .uses {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .card.uc {
    padding: 12px;
  }

  .uc .txt {
    order: 1;
    padding: 20px 12px 12px;
  }

  .uc .txt > p:not(.who) {
    padding: 0;
  }

  .uc h3 {
    line-height: 1.3;
    padding: 0;
  }

  .vig.scene {
    height: auto;
    padding: 0;
    display: block;
    background: #151515;
  }

  .card.uc-lead {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    align-items: end;
    gap: 12px;
  }

  .uc-lead .txt {
    order: 0;
    padding: 24px 12px 16px;
  }

  .uc-lead h3 {
    font-size: 1.375rem;
    letter-spacing: -0.02em;
  }

  .card .who {
    padding: 0;
    margin: 0 0 8px;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--orange);
  }

  .uc .who + h3 {
    margin-top: 0;
  }

  .more {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
    padding: 0;
  }

  .more li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 14px;
    border-radius: 17px;
    border: 1px solid var(--card-line);
    background: var(--card);
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .more li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .more li.etc {
    border-style: dashed;
    border-color: var(--line-strong);
    background: transparent;
    color: var(--ink);
  }

  .more li.etc::before {
    background: var(--orange);
  }

  /* status lists */
  .card.list {
    padding: 28px;
  }

  .card.list h3 {
    margin-top: 0;
    padding: 0;
  }

  .list ul {
    list-style: none;
    margin-top: 16px;
    padding: 0;
  }

  .list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 0;
    border-top: 1px solid var(--card-line);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .list li svg {
    flex: none;
    margin-top: 4px;
    stroke: var(--green);
    stroke-width: 1.8;
  }

  .tag {
    flex: none;
    min-width: 44px;
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid var(--line-strong);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-align: center;
    color: var(--ink);
  }

  .list li > span {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
  }

  /* pricing: Free on the left, a larger Pro card on the right */
  .plans {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 16px;
    align-items: stretch;
  }

  .card.plan {
    padding: 32px;
    gap: 0;
  }

  .card.plan h3 {
    margin: 0;
    padding: 0;
    font-size: 1.25rem;
  }

  .card .price {
    margin-top: 14px;
    font-size: 3rem;
    line-height: 1;
    font-weight: 650;
    letter-spacing: -0.04em;
    color: var(--ink);
    padding: 0 !important;
  }

  .card .price span {
    margin-left: 6px;
    font-size: 0.9375rem;
    font-weight: 450;
    letter-spacing: 0.01em;
    color: var(--ink-2);
  }

  .card.pro .price {
    margin-top: 18px;
  }

  .card .plan-sub {
    margin-top: 10px;
    padding: 0;
    color: var(--ink-2);
  }

  .plan > .btn {
    align-self: flex-start;
    margin-top: 24px;
  }

  .feats {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .feats li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .feats svg {
    flex: none;
    width: 15px;
    height: 15px;
    margin-top: 3px;
    fill: none;
    stroke: var(--green);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .card.plan.pro {
    padding: 40px;
    background:
      radial-gradient(90% 60% at 100% 0%, rgb(240 122 58 / 0.1), transparent 70%),
      linear-gradient(180deg, #1f1f1f, #181818);
    border-color: #3a3a3a;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.9), inset 0 1px 0 rgb(255 255 255 / 0.05);
  }

  .pro > .pro-tag {
    align-self: flex-start;
  }

  .pro .plan-sub {
    margin-top: 18px;
    max-width: 34ch;
    font-size: 1.125rem;
    line-height: 1.45;
    color: var(--ink);
  }

  .buy {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 24px;
  }

  .buy .btn {
    margin: 0;
  }

  .card .buy-note {
    margin: 0;
    padding: 0;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }

  .card .feats-head {
    margin-top: 32px;
    padding: 0;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }

  .pro-feats {
    margin-top: 14px;
    gap: 16px;
  }

  .pro-feats span {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .pro-feats b {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--ink);
  }

  .pro-feats em {
    white-space: nowrap;
    font-style: normal;
    height: 18px;
    display: inline-flex;
    align-items: center;
    padding: 0 7px;
    border-radius: 5px;
    border: 1px solid var(--line-strong);
    font-size: 10.5px;
    font-weight: 600;
    color: var(--ink-2);
  }

  .pro-feats small {
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .card .plan-note {
    margin-top: auto;
    padding: 28px 0 0;
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  /* closing */
  .end {
    padding: clamp(112px, 14vw, 176px) 20px 0;
    text-align: center;
  }

  .end h2 {
    margin-top: 28px;
  }

  .end p {
    margin-top: 14px;
    color: var(--ink-2);
