---
// Small illustrated scenes for the "Who it's for" cards, in the same dark language as the
// how-it-works diagram: graphite devices, orange packets riding from the audio sender to
// the listener, and the listener's live grille.
interface Props {
  kind: 'desk' | 'work' | 'party';
}
const { kind } = Astro.props;
const pk = `pk-${kind}`;
const labels = {
  desk: 'A PC monitor and a MacBook side by side on a desk. The MacBook plays a video, its audio travels to the PC as orange packets, and the headphones plugged into the PC play it.',
  work: 'A gaming PC running a game next to a work laptop on a video call with a new message. The laptop’s audio travels to the PC and plays in the headset.',
  party: 'A living room PC running Aonin between two speakers. Two friends’ laptops on the coffee table play music and send it to the PC; one shows the private code.',
};
// gentle hills for the video thumbnail
const hills = 'M0 62 C 18 50, 30 54, 46 46 C 62 38, 74 48, 92 42 C 108 37, 124 44, 138 40 V 84 H 0 Z';
---
<svg class="ao-scene" viewBox="0 0 560 300" role="img" aria-label={labels[kind]}>
  <defs>
    <g id={pk} transform="scale(0.72)">
      <rect x="-14" y="-5" width="16" height="10" rx="2.5" fill="#f07a3a" />
      <rect x="-26" y="-5" width="11" height="10" rx="2.5" fill="#f07a3a" opacity="0.35" />
    </g>
    <linearGradient id={`${kind}-dusk`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3a2418" /><stop offset="0.6" stop-color="#1c1714" /><stop offset="1" stop-color="#121212" />
    </linearGradient>
    <linearGradient id={`${kind}-sky`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1d2a3a" /><stop offset="1" stop-color="#151a20" />
    </linearGradient>
    <radialGradient id={`${kind}-glow`} cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#f07a3a" stop-opacity="0.18" /><stop offset="1" stop-color="#f07a3a" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- desk / floor -->
  <rect y="256" width="560" height="44" fill="#181818" />
  <path d="M0 256.5 H 560" stroke="#2c2c2c" />

  {kind === 'desk' && (
    <g>
      <!-- PC monitor: an editor open, Aonin listening in the corner -->
      <rect x="70" y="34" width="262" height="170" rx="9" fill="#0e0e0e" stroke="#484847" />
      <rect x="78" y="42" width="246" height="154" rx="3" fill="#151515" />
      <rect x="78" y="42" width="44" height="154" fill="#191919" />
      {[0, 1, 2, 3, 4].map((i) => <rect x="88" y={56 + i * 16} width="24" height="5" rx="2" fill={i === 1 ? '#3a3a3a' : '#262626'} />)}
      {[
        [130, 92, '#2e2e2e'], [130, 140, '#3a2a20'], [142, 70, '#2e2e2e'], [142, 110, '#2e2e2e'], [130, 56, '#3a2a20'],
        [142, 124, '#2e2e2e'], [130, 84, '#2e2e2e'], [142, 60, '#2e2e2e'],
      ].map(([x, w, c], i) => <rect x={x} y={56 + i * 14} width={w} height="5" rx="2" fill={c} />)}
      <rect x="198" y="132" width="116" height="54" rx="7" fill="#212121" stroke="#353535" />
      <rect x="198" y="132" width="116" height="17" rx="7" fill="#131313" />
      <rect x="198" y="142" width="116" height="7" fill="#131313" />
      <circle cx="208" cy="141" r="3" fill="#f07a3a" />
      <text x="215" y="144.5" class="s s-tiny s-dim">Listening</text>
      <text x="207" y="164" class="s s-tiny">MacBook</text>
      <g data-meter data-level="0.6">
        {Array.from({ length: 10 }, (_, j) => <circle cx={209 + j * 9.6} cy="176" r="2.6" class={j < 6 ? 'hole on' : 'hole'} />)}
      </g>
      <rect x="191" y="204" width="20" height="36" fill="#262626" />
      <rect x="151" y="240" width="100" height="16" rx="4" fill="#2c2c2c" />

      <!-- MacBook playing a video -->
      <rect x="372" y="128" width="148" height="96" rx="7" fill="#0e0e0e" stroke="#484847" />
      <svg x="378" y="134" width="136" height="84" viewBox="0 0 138 84">
        <rect width="138" height="84" rx="2" fill={`url(#${kind}-dusk)`} />
        <circle cx="96" cy="34" r="12" fill="#f07a3a" opacity="0.85" />
        <path d={hills} fill="#1d1d1d" />
        <path d="M0 70 C 30 62, 60 72, 92 64 C 112 60, 126 66, 138 62 V 84 H 0 Z" fill="#161616" />
        <rect x="8" y="74" width="122" height="2.5" rx="1.25" fill="#484847" />
        <rect x="8" y="74" width="56" height="2.5" rx="1.25" fill="#f07a3a" class="s-progress" />
      </svg>
      <path d="M358 224 h176 l-9 9 h-158 z" fill="#484847" />
      <rect x="430" y="224" width="32" height="3" rx="1.5" fill="#5a5a58" />

      <!-- the MacBook's sound rides to the PC -->
      <path id="desk-route" d="M408 126 C 400 70, 372 60, 336 84" class="s-path" />
      {[0, 1, 2].map((k) => (
        <use href={`#${pk}`}>
          <animateMotion dur="1.8s" begin={`${-k * 0.6}s`} repeatCount="indefinite" rotate="auto" path="M408 126 C 400 70, 372 60, 336 84" />
        </use>
      ))}

      <!-- headphones plugged into the PC -->
      <path d="M34 244 C 60 270, 130 268, 160 250" class="s-cable" />
      <g transform="translate(8 200)">
        <circle cx="26" cy="28" r="40" fill={`url(#${kind}-glow)`} />
        <path d="M4 34 V 24 a22 22 0 0 1 44 0 V 34" class="s-band" />
        <rect x="-2" y="26" width="13" height="24" rx="5" class="s-cup" />
        <rect x="41" y="26" width="13" height="24" rx="5" class="s-cup" />
      </g>
      <g class="s-waves" transform="translate(34 210)">
        <path d="M30 -2 a10 10 0 0 1 0 16" />
        <path d="M36 -8 a18 18 0 0 1 0 28" />
      </g>
    </g>
  )}

  {kind === 'work' && (
    <g>
      <!-- gaming PC monitor running a game -->
      <rect x="28" y="34" width="262" height="170" rx="9" fill="#0e0e0e" stroke="#484847" />
      <svg x="36" y="42" width="246" height="154" viewBox="0 0 246 154">
        <rect width="246" height="154" fill={`url(#${kind}-sky)`} />
        <path d="M0 96 L 40 64 L 70 84 L 112 46 L 150 80 L 184 60 L 246 94 V 154 H 0 Z" fill="#1a2028" />
        <path d="M0 116 C 60 104, 120 120, 246 108 V 154 H 0 Z" fill="#141a1f" />
        <path d="M123 70 v 12 M117 76 h 12" stroke="#e9e9e7" stroke-width="1.4" opacity="0.8" />
        <rect x="10" y="136" width="60" height="5" rx="2.5" fill="#262c33" />
        <rect x="10" y="136" width="44" height="5" rx="2.5" fill="#9bbe55" />
        <rect x="200" y="132" width="36" height="12" rx="3" fill="#262c33" />
        <text x="218" y="141" class="s s-tiny" text-anchor="middle">32/90</text>
      </svg>
      <rect x="149" y="204" width="20" height="36" fill="#262626" />
      <rect x="109" y="240" width="100" height="16" rx="4" fill="#2c2c2c" />

      <!-- work laptop: a video call and a new message -->
      <rect x="352" y="118" width="168" height="106" rx="7" fill="#0e0e0e" stroke="#484847" />
      <rect x="358" y="124" width="156" height="94" rx="2" fill="#161616" />
      {[[362, 128], [438, 128], [362, 172], [438, 172]].map(([x, y], i) => (
        <g>
          <rect x={x} y={y} width="72" height="40" rx="3" fill="#1f1f1f" stroke={i === 1 ? '#9bbe55' : 'none'} stroke-width="1.5" />
          <circle cx={x + 36} cy={y + 17} r="7" fill="#353535" />
          <path d={`M${x + 24} ${y + 36} a12 9 0 0 1 24 0`} fill="#353535" />
        </g>
      ))}
      <g class="s-toast">
        <rect x="430" y="96" width="98" height="28" rx="7" fill="#212121" stroke="#484847" />
        <circle cx="443" cy="110" r="3.5" fill="#f07a3a" />
        <text x="452" y="113.5" class="s s-tiny">New message</text>
      </g>
      <path d="M338 224 h196 l-9 9 h-178 z" fill="#484847" />

      <!-- the laptop's call rides to the PC -->
      <path d="M380 116 C 372 70, 340 62, 294 86" class="s-path" />
      {[0, 1, 2].map((k) => (
        <use href={`#${pk}`}>
          <animateMotion dur="1.8s" begin={`${-k * 0.6}s`} repeatCount="indefinite" rotate="auto" path="M380 116 C 372 70, 340 62, 294 86" />
        </use>
      ))}

      <!-- headset by the PC -->
      <path d="M300 250 C 280 266, 240 266, 210 252" class="s-cable" />
      <g transform="translate(298 210) scale(0.92)">
        <circle cx="26" cy="28" r="40" fill={`url(#${kind}-glow)`} />
        <path d="M4 34 V 24 a22 22 0 0 1 44 0 V 34" class="s-band" />
        <rect x="-2" y="26" width="13" height="24" rx="5" class="s-cup" />
        <rect x="41" y="26" width="13" height="24" rx="5" class="s-cup" />
        <path d="M2 46 q -6 8 4 10" class="s-band" />
      </g>
    </g>
  )}

  {kind === 'party' && (
    <g>
      <!-- the living room PC, Aonin open on screen -->
      <rect x="166" y="22" width="228" height="142" rx="8" fill="#0e0e0e" stroke="#484847" />
      <rect x="173" y="29" width="214" height="128" rx="3" fill="#212121" />
      <rect x="173" y="29" width="214" height="22" rx="3" fill="#131313" />
      <text x="182" y="44" class="s s-tiny s-strong">Aonin</text>
      <circle cx="316" cy="40" r="3" fill="#f07a3a" />
      <text x="378" y="43.5" class="s s-tiny s-dim" text-anchor="end">Listening</text>
      <text x="182" y="66" class="s s-tiny s-dim">Audio senders</text>
      {[['Maya’s MacBook', 0.7], ['Sam’s laptop', 0.45]].map(([name, lvl], i) => (
        <g>
          <circle cx="185" cy={84 + i * 28} r="3" fill="#9bbe55" />
          <text x="194" y={87.5 + i * 28} class="s s-tiny">{name}</text>
          <g data-meter data-level={lvl}>
            {Array.from({ length: 8 }, (_, j) => <circle cx={300 + j * 9.6} cy={84 + i * 28} r="2.6" class={j < Math.round(Number(lvl) * 8) ? 'hole on' : 'hole'} />)}
          </g>
          <path d={`M182 ${98.5 + i * 28} H 378`} stroke="#353535" />
        </g>
      ))}
      <rect x="270" y="164" width="20" height="18" fill="#262626" />
      <rect x="236" y="182" width="88" height="10" rx="3" fill="#2c2c2c" />

      <!-- speakers -->
      {[96, 418].map((x, i) => (
        <g>
          <rect x={x} y="96" width="46" height="160" rx="6" fill="#212121" stroke="#353535" />
          <circle cx={x + 23} cy="124" r="8" fill="#151515" stroke="#484847" />
          <circle cx={x + 23} cy="190" r="17" fill="#151515" stroke="#484847" />
          <circle cx={x + 23} cy="190" r="6" fill="#262626" class="s-cone" style={`animation-delay:${i * -0.2}s`} />
          <g class="s-waves" transform={`translate(${i ? x + 54 : x - 8} 176) scale(${i ? 1 : -1} 1)`}>
            <path d="M0 0 a10 10 0 0 1 0 28" />
            <path d="M8 -8 a20 20 0 0 1 0 44" />
          </g>
        </g>
      ))}

      <!-- coffee table with two laptops playing music -->
      <rect x="150" y="248" width="260" height="10" rx="3" fill="#262626" />
      {[[176, 'M'], [298, 'S']].map(([x, who], i) => (
        <g>
          <rect x={x} y="196" width="86" height="52" rx="5" fill="#0e0e0e" stroke="#484847" />
          <rect x={Number(x) + 5} y="201" width="76" height="42" rx="2" fill="#161616" />
          <rect x={Number(x) + 11} y="207" width="28" height="28" rx="3" fill={i ? '#9bbe55' : '#f07a3a'} opacity="0.85" />
          <rect x={Number(x) + 45} y="211" width="30" height="4" rx="2" fill="#353535" />
          <rect x={Number(x) + 45} y="219" width="20" height="4" rx="2" fill="#2a2a2a" />
          <rect x={Number(x) + 45} y="230" width="30" height="2.5" rx="1.25" fill="#353535" />
          <rect x={Number(x) + 45} y="230" width={i ? 18 : 10} height="2.5" rx="1.25" fill="#e9e9e7" class="s-progress" />
        </g>
      ))}

      <!-- the private code -->
      <g transform="translate(240 266)">
        <rect x="0" y="0" width="80" height="22" rx="6" fill="#2c2c2c" stroke="#484847" />
        <path transform="translate(8 5) scale(0.85)" d="M3 6.5h8a1 1 0 0 1 1 1v4.5a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V7.5a1 1 0 0 1 1-1z M4.5 6.5V4.5a2.5 2.5 0 0 1 5 0v2" class="s-ico" />
        <text x="24" y="15" class="s s-tiny s-code">K7Q 4MZ</text>
      </g>

      <!-- both laptops send to the PC -->
      {['M219 194 C 214 176, 230 168, 250 164', 'M341 194 C 346 180, 324 172, 308 166'].map((d) => (
        <g>
          <path d={d} class="s-path" />
          {[0, 1].map((k) => (
            <use href={`#${pk}`}>
              <animateMotion dur="1.5s" begin={`${-k * 0.75}s`} repeatCount="indefinite" rotate="auto" path={d} />
            </use>
          ))}
        </g>
      ))}
    </g>
  )}
</svg>

<style>
  .ao-scene {
    display: block;
    width: 100%;
    height: auto;
    font-family: 'Hanken Grotesk Variable', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-feature-settings: 'tnum' 1;
  }

  .ao-scene :global(.s) { fill: #e9e9e7; }
  .ao-scene :global(.s-tiny) { font-size: 9.5px; letter-spacing: 0.03em; }
  .ao-scene :global(.s-dim) { fill: #a2a2a0; }
  .ao-scene :global(.s-strong) { font-weight: 650; }
  .ao-scene :global(.s-code) { font-size: 11px; letter-spacing: 0.08em; font-weight: 600; }

  .ao-scene :global(.s-path) {
    fill: none;
    stroke: #484847;
    stroke-width: 1.6;
    stroke-dasharray: 1 6;
    stroke-linecap: round;
  }

  .ao-scene :global(.s-cable) {
    fill: none;
    stroke: #353535;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .ao-scene :global(.s-band) {
    fill: none;
    stroke: #e9e9e7;
    stroke-width: 3;
    stroke-linecap: round;
  }

  .ao-scene :global(.s-cup) { fill: #2c2c2c; stroke: #e9e9e7; stroke-width: 1.5; }

  .ao-scene :global(.s-ico) {
    fill: none;
    stroke: #e9e9e7;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ao-scene :global(.s-waves path) {
    fill: none;
    stroke: #f07a3a;
    stroke-width: 1.8;
    stroke-linecap: round;
    animation: s-wave 1.6s ease-in-out infinite;
  }

  .ao-scene :global(.s-waves path:nth-child(2)) { animation-delay: 0.25s; }

  @keyframes s-wave {
    0%, 100% { opacity: 0.15; }
    50% { opacity: 0.9; }
  }

  .ao-scene :global(.s-cone) {
    transform-box: fill-box;
    transform-origin: center;
    animation: s-cone 0.5s ease-in-out infinite;
  }

  @keyframes s-cone {
    50% { transform: scale(1.25); }
  }

  .ao-scene :global(.s-toast) {
    animation: s-toast 5s ease-in-out infinite;
  }

  @keyframes s-toast {
    0%, 8% { opacity: 0; transform: translateY(6px); }
    16%, 70% { opacity: 1; transform: none; }
    80%, 100% { opacity: 0; }
  }

  .ao-scene :global(.hole) { fill: #4a4a4a; transition: fill 90ms linear; }
  .ao-scene :global(.hole.on) { fill: #e9e9e7; }
  .ao-scene :global(.hole.flash) { fill: #f07a3a; transition: none; }

  @media (prefers-reduced-motion: reduce) {
    .ao-scene :global(.s-waves path),
    .ao-scene :global(.s-cone),
    .ao-scene :global(.s-toast) {
      animation: none;
    }
  }
</style>
