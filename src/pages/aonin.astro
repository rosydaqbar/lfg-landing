    }

    .ui-field i,
    .thanks[open] {
      animation: none;
    }

    @keyframes fade {
      from { opacity: 0; }
    }
  }
</style>

<script>
  /* The grille meters move like live audio; now and then one hole flashes orange for a
     repaired packet, the way the real app does. */
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const meters = Array.from(document.querySelectorAll<SVGGElement>('[data-meter]'));

  if (calm) {
    document.querySelectorAll<SVGSVGElement>('.ao-flow, .ao-scene').forEach((s) => s.pauseAnimations());
  }

  if (!calm && meters.length) {
    const rows = meters.map((m) => ({
      holes: Array.from(m.querySelectorAll<SVGCircleElement>('circle')),
      base: Number(m.dataset.level ?? 0),
      level: Number(m.dataset.level ?? 0),
      muted: m.hasAttribute('data-muted'),
      seed: Math.random() * 10,
    }));

    let t = 0;
    window.setInterval(() => {
      if (document.hidden) return;
      t += 0.09;
      for (const r of rows) {
        if (r.muted) continue;
        const target = Math.max(0.05, Math.min(1, r.base + Math.sin(t * 0.9 + r.seed) * 0.18 + (Math.random() - 0.5) * 0.28));
        r.level += (target - r.level) * 0.55;
        const lit = Math.round(r.level * r.holes.length);
        r.holes.forEach((h, i) => h.classList.toggle('on', i < lit));
        if (Math.random() < 0.012 && lit > 1) {
          const h = r.holes[lit - 1];
          h.classList.add('flash');
          window.setTimeout(() => h.classList.remove('flash'), 700);
        }
      }
    }, 90);
  }
</script>

<script>
  /* Try now: point every download button at the installer for this computer, taken from
     the latest GitHub release, then thank the person and offer a Pro trial key. Anything
     we can't match (Linux, phones, an API hiccup) falls back to the releases page. */
  const REPO = 'rosydaqbar/aonin';
  const buttons = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-download]'));
  const note = document.querySelector<HTMLElement>('[data-dl-note]');
  const direct = document.querySelector<HTMLAnchorElement>('[data-dl-direct]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-thanks]');

  // Analytics (Umami). Quietly does nothing when the tracker is blocked or not loaded.
  const track = (name: string, data?: Record<string, string>) => {
    try {
      (window as unknown as { umami?: { track: (n: string, d?: object) => void } }).umami?.track(name, data);
    } catch {}
  };
  let version = '';
  let direct_ok = false;

  type Asset = { name: string; browser_download_url: string };
  type Release = { tag_name: string; html_url: string; assets: Asset[] };

  const ua = navigator.userAgent;
  const platform = (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform || navigator.platform || '';
  const touchMac = /Mac/i.test(platform) && navigator.maxTouchPoints > 1; // iPadOS reports a Mac
  const os: 'windows' | 'mac' | null = /Win/i.test(platform) || /Windows/i.test(ua)
    ? 'windows'
    : /Mac/i.test(platform) && !touchMac && !/iPhone|iPad/i.test(ua)
      ? 'mac'
      : null;

  const pick: Record<'windows' | 'mac', RegExp> = { windows: /x64-setup\.exe$/i, mac: /\.dmg$/i };
  const label = { windows: 'Windows', mac: 'macOS (Apple Silicon)' };

  const apply = (r: Release) => {
    const asset = os ? r.assets.find((a) => pick[os].test(a.name)) : undefined;
    version = r.tag_name.replace(/^v/, '');
    direct_ok = !!asset;
    if (asset) {
      buttons.forEach((b) => {
        b.href = asset.browser_download_url;
        b.removeAttribute('target');
      });
      if (direct) direct.href = asset.browser_download_url;
      if (note && os) note.textContent = `Free · ${label[os]}`;
    } else {
      buttons.forEach((b) => {
        b.href = r.html_url;
        b.target = '_blank';
        b.rel = 'noopener';
      });
      if (direct) direct.href = r.html_url;
      if (note) note.textContent = 'Free · Windows and macOS';
    }
  };

  const load = async (): Promise<Release | null> => {
    try {
      const cached = sessionStorage.getItem('aonin-release');
      if (cached) return JSON.parse(cached);
    } catch {}
    try {
      const res = await fetch(`https://api.github.com/repos/${REPO}/releases/latest`, { headers: { Accept: 'application/vnd.github+json' } });
      if (!res.ok) return null;
      const r = (await res.json()) as Release;
      const slim: Release = { tag_name: r.tag_name, html_url: r.html_url, assets: r.assets.map((a) => ({ name: a.name, browser_download_url: a.browser_download_url })) };
      try { sessionStorage.setItem('aonin-release', JSON.stringify(slim)); } catch {}
      return slim;
    } catch {
      return null;
    }
  };

  // Until the release loads, the buttons open the releases page in a new tab.
  buttons.forEach((b) => {
    b.target = '_blank';
    b.rel = 'noopener';
  });
  load().then((r) => r && apply(r));

  // The download goes ahead as a normal link; the thank-you dialog opens over the page.
  const osName = os ?? 'other';
  let discordClicked = false;
  buttons.forEach((b) => b.addEventListener('click', () => {
    track('download_click', { location: b.dataset.download || 'unknown', os: osName, version: version || 'unknown' });
    if (!direct_ok) track('download_fallback', { os: osName });
    if (dialog && !dialog.open) window.setTimeout(() => {
      dialog.showModal();
      discordClicked = false;
      track('thanks_open', { os: osName });
    }, 150);
  }));
  direct?.addEventListener('click', () => track('download_retry', { os: osName }));
  dialog?.querySelector('[data-discord]')?.addEventListener('click', () => {
    discordClicked = true;
    track('discord_click', { os: osName });
  });
  dialog?.querySelector<HTMLDetailsElement>('[data-install]')?.addEventListener('toggle', (e) => {
    if ((e.currentTarget as HTMLDetailsElement).open) track('install_help_open', { os: osName });
  });
  dialog?.addEventListener('close', () => { if (!discordClicked) track('thanks_close', { os: osName }); });
  dialog?.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

  // Pro demand before Purchase opens
  document.querySelector('[data-purchase]')?.addEventListener('click', () => track('purchase_click'));

  // Pricing actually seen (40% on screen), once per visit
  const pricing = document.getElementById('pricing');
  if (pricing && 'IntersectionObserver' in window) {
    const seen = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        track('pricing_view');
        seen.disconnect();
      }
    }, { threshold: 0.4 });
    seen.observe(pricing);
  }
</script>

<script define:vars={{ checkout: aoninCheckout }}>
  /* Purchase: Paddle's overlay checkout on this page, then the license key from
     aonin.lfg.ink/license as soon as the payment webhook has been handled. */
  const button = document.querySelector('[data-purchase]');
  const dlg = document.querySelector('[data-bought]');
  const track = (name, data) => { try { window.umami?.track(name, data); } catch {} };
  let ready = null;

  function paddle() {
    if (ready) return ready;
    ready = new Promise((resolve, reject) => {
      const tag = document.createElement('script');
      tag.src = 'https://cdn.paddle.com/paddle/v2/paddle.js';
      tag.onload = () => {
        if (checkout.env === 'sandbox') window.Paddle.Environment.set('sandbox');
        window.Paddle.Initialize({
          token: checkout.clientToken,
          eventCallback: (e) => {
            if (e.name === 'checkout.completed') {
              const txn = e.data?.transaction_id;
              track('purchase_complete');
              window.Paddle.Checkout.close();
              if (txn) showKey(txn);
            }
          },
        });
        resolve(window.Paddle);
      };
      tag.onerror = () => { ready = null; reject(new Error('Paddle did not load')); };
      document.head.appendChild(tag);
    });
    return ready;
  }

  function state(name) {
    dlg.querySelectorAll('[data-state]').forEach((el) => { el.hidden = el.dataset.state !== name; });
  }

  async function showKey(txn) {
    dlg.querySelectorAll('[data-order]').forEach((el) => { el.textContent = txn; });
    state('wait');
    if (!dlg.open) dlg.showModal();
    for (let i = 0; i < 45; i++) {
      try {
        const r = await fetch(`${checkout.license}/v1/order/${encodeURIComponent(txn)}`);
        if (r.ok) {
          const o = await r.json();
          dlg.querySelector('[data-key]').textContent = o.key;
          state('ready');
          return;
        }
      } catch {}
      await new Promise((r) => setTimeout(r, 2000));
    }
    state('late');
  }

  // Indonesia: Paddle locates the visitor (same as for tax); show the INDO price and banner.
  let indo = false;
  const indoBar = document.querySelector('[data-indo]');
  async function detectIndo() {
    if (!checkout.indo) return;
    try {
      const P = await paddle();
      const r = await P.PricePreview({ items: [{ priceId: checkout.priceId, quantity: 1 }] });
      const cc = r?.data?.address?.countryCode ?? r?.data?.address?.country_code;
      if (cc !== 'ID') return;
      indo = true;
      document.querySelector('[data-price-now]').textContent = checkout.indo.price;
      const label = document.querySelector('[data-price-label]');
      if (label) label.textContent = 'Indonesia offer';
      let closed = false;
      try { closed = sessionStorage.getItem('indo-bar') === 'closed'; } catch {}
      if (indoBar && !closed) indoBar.hidden = false;
      track('indo_price_shown');
    } catch {}
  }
  indoBar?.querySelector('[data-indo-close]')?.addEventListener('click', () => {
    indoBar.hidden = true;
    try { sessionStorage.setItem('indo-bar', 'closed'); } catch {}
  });
  if ('requestIdleCallback' in window) requestIdleCallback(detectIndo, { timeout: 2500 }); else setTimeout(detectIndo, 800);

  button?.addEventListener('click', async () => {
    track('purchase_open');
    button.setAttribute('aria-busy', 'true');
    try {
      const P = await paddle();
      P.Checkout.open({
        items: [{ priceId: checkout.priceId, quantity: 1 }],
        ...((indo ? checkout.indo.discountId : checkout.discountId) ? { discountId: indo ? checkout.indo.discountId : checkout.discountId } : {}),
        settings: { displayMode: 'overlay', variant: 'one-page' },
      });
    } catch {
      window.location.href = `${checkout.license}/buy`;
    } finally {
      button.removeAttribute('aria-busy');
    }
  });

  dlg?.querySelector('[data-copy]')?.addEventListener('click', async (e) => {
    const key = dlg.querySelector('[data-key]').textContent;
    try { await navigator.clipboard.writeText(key); e.currentTarget.textContent = 'Copied'; } catch {}
  });
  dlg?.querySelector('[data-close]')?.addEventListener('click', () => dlg.close());
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });

  // Find a key again.
  const find = document.querySelector('[data-find]');
  const form = find?.querySelector('[data-find-form]');
  const err = find?.querySelector('[data-err]');
  const findState = (name) => find.querySelectorAll('[data-state]').forEach((el) => { el.hidden = el.dataset.state !== name; });
  const openFind = () => {
    if (dlg?.open) dlg.close();
    findState('form');
    if (!find.open) find.showModal();
    track('findkey_open');
  };
  document.querySelectorAll('[data-find-open]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); openFind(); }));
  if (location.hash === '#find-key') openFind();
  const fail = (text) => { err.textContent = text; err.hidden = false; };
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.hidden = true;
    const txn = form.txn.value.trim();
    const email = form.email.value.trim();
    if (!/^txn_[a-z0-9]{26}$/.test(txn)) return fail('Enter an order ID that starts with txn_. You’ll find it in your Paddle receipt email.');
    if (!email.includes('@')) return fail('Enter the email address you used at checkout.');
    const go = form.querySelector('[data-find-go]');
    go.setAttribute('aria-busy', 'true');
    try {
      const r = await fetch(`${checkout.license}/v1/order/${encodeURIComponent(txn)}?email=${encodeURIComponent(email)}`);
      if (r.status === 200) {
        find.querySelector('[data-key]').textContent = (await r.json()).key;
        findState('ready');
        track('findkey_found');
      } else if (r.status === 429) fail('Too many tries. Wait a few minutes, then try again.');
      else fail('We couldn’t find a license key with those details. Check the order ID and email address, then try again.');
    } catch {
      fail('We couldn’t look up your license key. Try again.');
    } finally {
      go.removeAttribute('aria-busy');
    }
  });
  find?.querySelector('[data-copy]')?.addEventListener('click', async (e) => {
    try { await navigator.clipboard.writeText(find.querySelector('[data-key]').textContent); e.currentTarget.textContent = 'Copied'; } catch {}
  });
  find?.querySelector('[data-close]')?.addEventListener('click', () => find.close());
  find?.addEventListener('click', (e) => { if (e.target === find) find.close(); });
  find?.addEventListener('close', () => { if (location.hash === '#find-key') history.replaceState(null, '', location.pathname); });
</script>
