---
import '@fontsource-variable/hanken-grotesk';
import Base from '../layouts/Base.astro';
import WindowArt from '../components/aonin/WindowArt.astro';
import PopoverArt from '../components/aonin/PopoverArt.astro';
import FlowArt from '../components/aonin/FlowArt.astro';
import appIcon from '../assets/aonin/app-icon.svg?raw';

// Every claim below comes from the Aonin README / app. Nothing invented.
const steps = [
  {
    n: '01',
    title: 'One computer listens',
    body: 'Pick any machine as the listener. It mixes every stream and plays them on one output: headphones, speakers or a USB DAC.',
  },
  {
    n: '02',
    title: 'The others send',
    body: 'Every running Aonin shows up on the network by itself. The other computers join as audio senders and stream their system audio, their mic, or both.',
  },
  {
    n: '03',
    title: 'You hear all of it',
    body: 'Set each computer’s volume, mute one, and watch its level live. Audio senders can hear the listener back, too.',
  },
];

const quality = [
  { name: 'Highest', detail: '24-bit · 48 kHz, uncompressed', rate: '2.3 Mbps', on: true },
  { name: 'CD', detail: '16-bit · 48 kHz, CD quality', rate: '1.5 Mbps' },
  { name: 'Balanced', detail: 'Opus, for busy Wi-Fi', rate: '256 kbps' },
  { name: 'Saver', detail: 'Opus, for weak Wi-Fi', rate: '96 kbps' },
];

const health = [
  { name: 'Studio MacBook Pro', lat: '21.8 ms', target: '20.0 ms', rep: 4, gaps: 0, drops: 0, mark: 'live' },
  { name: 'Office MacBook', lat: '24.1 ms', target: '23.0 ms', rep: 11, gaps: 0, drops: 1, mark: 'error' },
  { name: 'Work Laptop', lat: '18.0 ms', target: '18.0 ms', rep: 0, gaps: 0, drops: 0, mark: 'live' },
];

const done = [
  'Highest-quality streaming with redundancy, retransmit and an adaptive jitter buffer',
  'System audio and mic capture on Windows and macOS, no drivers',
  'Discovery on the local network, loop detection and auto-reconnect',
  'Per-device volume, mute and live meters from the tray or menu bar',
  'Hand the listener role to another device',
  'Private listeners with a code, and encrypted audio',
];

const next = [
  { tag: 'V1', text: 'Sign in so your own devices trust each other without a code' },
  { tag: 'V1.1', text: 'Android and iOS: listen and send the mic first' },
  { tag: 'V1.2', text: 'A Mac app redesigned in the native macOS look' },
  { tag: 'Later', text: 'Code signing for Windows and macOS' },
];
---
<Base
  title="Aonin · Coming soon"
  description="Aonin: hear every computer on your desk through one pair of headphones. Local network only, uncompressed 24-bit audio, no drivers. Coming soon for Windows and macOS."
>
  <div class="page">
    <!-- Hero -->
    <header class="stage">
      <span class="icon" set:html={appIcon} aria-hidden="true" />

      <p class="soon"><i aria-hidden="true"></i>coming soon</p>
      <h1>Aonin</h1>
      <p class="tagline">Hear every computer on your desk through one pair of headphones.</p>
      <p class="meta">Windows &amp; macOS · local network only</p>

      <a class="btn" href="/">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
        Back to home
      </a>

      <figure class="preview" data-ao-art>
        <div class="win"><WindowArt /></div>
        <div class="pop"><PopoverArt /></div>
      </figure>
    </header>

    <main>
      <!-- How it works -->
      <section class="sec" aria-labelledby="how-h">
        <div class="wrap">
          <div class="head" data-reveal="head">
            <p class="eyebrow">How it works</p>
            <h2 id="how-h">One listener.<br />Every other computer sends to it.</h2>
            <p class="lede">Aonin runs from the tray on Windows and the menu bar on macOS. The same app goes on every machine, and any of them can be the listener.</p>
          </div>

          <div class="flowcard" data-reveal="rise">
            <div class="flowscroll"><FlowArt /></div>
          </div>

          <ol class="steps" data-reveal="rise" data-reveal-group>
            {steps.map((s) => (
              <li>
                <span class="num">{s.n}</span>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- Features -->
      <section class="sec" aria-labelledby="feat-h">
        <div class="wrap">
          <div class="head" data-reveal="head">
            <p class="eyebrow">Why it’s different</p>
            <h2 id="feat-h">Small app.<br />No compromises on sound.</h2>
            <p class="lede">No servers, no accounts and no drivers. Just your computers, your network, and the best audio it can carry.</p>
          </div>

          <div class="grid" data-reveal="rise" data-reveal-group>
            <article class="card">
              <div class="vig">
                <div class="ui">
                  <p class="ui-head">Listeners on this network</p>
                  <div class="ui-row">
                    <i class="dot green"></i>
                    <span class="ui-who"><b>PC-Studio</b><small>2 audio senders</small></span>
                    <span class="ui-btn">Connect</span>
                  </div>
                  <div class="ui-row">
                    <i class="dot green"></i>
                    <span class="ui-who"><b>Living Room PC</b><small>1 audio sender</small></span>
                    <span class="ui-btn">Connect</span>
                  </div>
                </div>
              </div>
              <h3>Pure local network</h3>
              <p>Devices find each other on the LAN and nothing leaves it. No servers, no accounts.</p>
            </article>

            <article class="card">
              <div class="vig">
                <div class="ui">
                  <p class="ui-head">Quality</p>
                  {quality.map((q) => (
                    <div class="ui-radio" data-on={q.on ? '' : undefined}>
                      <i></i>
                      <span class="ui-who"><b>{q.name}</b><small>{q.detail}</small></span>
                      <small class="r">{q.rate}</small>
                    </div>
                  ))}
                </div>
              </div>
              <h3>Highest quality by default</h3>
              <p>Uncompressed 24-bit / 48 kHz out of the box, with lighter tiers for weak networks.</p>
            </article>

            <article class="card">
              <div class="vig">
                <div class="pk-stage">
                  <div class="packets" aria-hidden="true">
                    <span><i></i><b></b></span>
                    <span><i></i><b></b></span>
                    <span class="lost"><i></i><b></b></span>
                    <span class="fixed"><i></i><b></b></span>
                    <span><i></i><b></b></span>
                  </div>
                  <div class="pk-keys" aria-hidden="true">
                    <small class="k-lost">Lost on Wi-Fi</small>
                    <small class="k-fixed">Rebuilt from the next one</small>
                  </div>
                  <p class="pk-note"><b>2 ms</b> per packet, plus a copy of the 2 ms before it</p>
                </div>
              </div>
              <h3>Real time over Wi-Fi</h3>
              <p>Typically 15–30 ms of buffering. A lost packet is rebuilt from the next one, and longer gaps are sent again.</p>
            </article>

            <article class="card">
              <div class="vig">
                <div class="ui">
                  <div class="ui-switch">
                    <span class="ui-ico"><svg viewBox="0 0 14 14"><path d="M1.5 2h11v7.5h-11z M5 12.5h4 M7 9.5v3" /></svg></span>
                    <span class="ui-who"><b>System audio</b><small>Everything this device plays</small></span>
                    <span class="ui-track on"><i></i></span>
                  </div>
                  <div class="ui-switch">
                    <span class="ui-ico"><svg viewBox="0 0 14 14"><path d="M5 1.5h4v6.5a2 2 0 0 1-4 0z M2.5 7a4.5 4.5 0 0 0 9 0 M7 11.5v2" /></svg></span>
                    <span class="ui-who"><b>Microphone</b><small>USB Microphone</small></span>
                    <span class="ui-track"><i></i></span>
                  </div>
                </div>
              </div>
              <h3>No drivers</h3>
              <p>System audio is captured with WASAPI loopback on Windows and the Core Audio process tap on macOS 14.2+.</p>
            </article>

            <article class="card">
              <div class="vig">
                <div class="ui">
                  <p class="ui-title">Join a private listener</p>
                  <small class="ui-hint">Type the code shown on the listener.</small>
                  <span class="ui-field">K7Q 4MZ<i aria-hidden="true"></i></span>
                  <span class="ui-actions"><span class="ui-btn quiet">Cancel</span><span class="ui-btn primary">Join</span></span>
                </div>
              </div>
              <h3>Private when you want it</h3>
              <p>A private listener shows a code. Only devices that type it can join, and the audio is encrypted.</p>
            </article>

            <article class="card">
              <div class="vig">
                <div class="ui ui-chips">
                  <small>Send</small>
                  <span><em class="on">System audio</em><em class="on">Mic on</em></span>
                  <small>Hear</small>
                  <span><em class="on">System audio</em><em>Mic</em></span>
                </div>
              </div>
              <h3>Audio both ways</h3>
              <p>An audio sender can hear the listener back: its apps, its mic, or both.</p>
            </article>
          </div>

          <div class="grid two" data-reveal="rise" data-reveal-group>
            <article class="card">
              <div class="vig">
                <div class="ui">
                  <div class="ui-row">
                    <i class="dot red"></i>
                    <span class="ui-who"><b>Studio iMac</b><small class="red">Joining would play your own audio back to you.</small></span>
                  </div>
                  <div class="ui-row">
                    <i class="dot green"></i>
                    <span class="ui-who"><b>PC-Studio</b><small>Listening · 2 audio senders</small></span>
                    <span class="ui-btn">Connect</span>
                  </div>
                </div>
              </div>
              <h3>No feedback loops</h3>
              <p>A device can’t join a listener whose audio already comes from it, because the sound would bounce back and forth. Those listeners stay visible, with the reason.</p>
            </article>

            <article class="card">
              <div class="vig">
                <div class="ui ui-confirm">
                  <p class="ui-title">Make Office MacBook the listener?</p>
                  <small class="ui-hint">Everyone’s audio will play there, this PC included.</small>
                  <span class="ui-actions"><span class="ui-btn quiet">Cancel</span><span class="ui-btn strong">Make listener</span></span>
                </div>
              </div>
              <h3>Hand over the listener</h3>
              <p>Make another computer the listener and every audio sender follows it. Nobody has to touch the other machines.</p>
            </article>
          </div>
        </div>
      </section>

      <!-- Network honesty -->
      <section class="sec" aria-labelledby="net-h">
        <div class="wrap split">
          <div class="head" data-reveal="head">
            <p class="eyebrow">Connection health</p>
            <h2 id="net-h">Tells you the truth about your network.</h2>
            <p class="lede">Each incoming stream gets an adaptive buffer that grows to cover the worst recent Wi-Fi stall and shrinks again while the network behaves. Aonin shows what it’s doing, per device, in plain words.</p>
            <dl class="legend">
              <dt>Repaired</dt><dd>Packets Wi-Fi lost that Aonin got back in time. Nothing was lost.</dd>
              <dt>Covered gaps</dt><dd>Packets that never arrived, smoothed over.</dd>
              <dt>Dropouts</dt><dd>The buffer ran dry and sound paused. Aonin raises the buffer after each one.</dd>
            </dl>
          </div>

          <div class="vig big" data-reveal="rise">
            <div class="ui ui-table">
              <p class="ui-head">Connection health</p>
              <table>
                <thead>
                  <tr><th></th><th>Device</th><th class="r">Latency</th><th class="r">Repaired</th><th class="r">Gaps</th><th class="r">Dropouts</th></tr>
                </thead>
                <tbody>
                  {health.map((h) => (
                    <tr>
                      <td><i class={`dot ${h.mark === 'live' ? 'green' : 'red'}`}></i></td>
                      <td class="nm">{h.name}</td>
                      <td class="r">{h.lat}<small>target {h.target}</small></td>
                      <td class="r">{h.rep}</td>
                      <td class="r">{h.gaps}</td>
                      <td class={h.drops ? 'r bad' : 'r'}>{h.drops}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- Status -->
      <section class="sec" aria-labelledby="status-h">
        <div class="wrap">
          <div class="head" data-reveal="head">
            <p class="eyebrow">Where it’s at</p>
            <h2 id="status-h">Early development. Already doing the job.</h2>
            <p class="lede">The engine and the listener / audio sender flow work today, tested between a Windows PC and a MacBook over Wi-Fi.</p>
          </div>

          <div class="grid two status" data-reveal="rise" data-reveal-group>
            <div class="card list">
              <h3>Working today</h3>
              <ul>
                {done.map((d) => (
                  <li><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M2.5 7.5 5.5 10.5 11.5 3.5" /></svg>{d}</li>
                ))}
              </ul>
            </div>
            <div class="card list">
              <h3>Coming next</h3>
              <ul class="next">
                {next.map((n) => (
                  <li><span class="tag">{n.tag}</span>{n.text}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Closing -->
      <section class="end" data-reveal="rise">
        <span class="icon sm" set:html={appIcon} aria-hidden="true" />
        <h2>Coming soon to Windows and macOS.</h2>
        <p>Aonin is free software under the GNU General Public License v3.</p>
        <a class="btn" href="/">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
          Back to home
        </a>
      </section>
    </main>

    <footer class="foot">© 2026 LFG.ink</footer>
  </div>
</Base>

<style>
  /* Aonin's own language: Braun charcoal housing, graphite, one orange accent, Hanken Grotesk. */
  :global(html),
  :global(body) {
    background: #131313;
  }

  .page {
    --housing: #212121;
    --recess: #191919;
    --raised: #2c2c2c;
    --strip: #131313;
    --ink: #e9e9e7;
    --ink-2: #a2a2a0;
    --ink-3: #7a7a78;
    --line: #353535;
    --line-strong: #484847;
    --card: #1a1a1a;
    --card-line: #262626;
    --orange: #f07a3a;
    --orange-ink: #f39260;
    --green: #9bbe55;
    --red: #e5584b;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);

    min-height: 100svh;
    overflow-x: clip;
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(60% 900px at 50% 0%, rgb(255 255 255 / 0.05), transparent 70%),
      var(--strip);
    color: var(--ink);
    font-family: 'Hanken Grotesk Variable', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-feature-settings: 'tnum' 1;
  }

  .page ::selection {
    background: var(--orange);
    color: #fff;
  }

  .page :focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 3px;
  }

  /* ---------- Hero (centered) ---------- */
  .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(72px, 12vh, 128px) 20px 0;
  }

  .stage > :not(.preview) {
    animation: rise 0.9s var(--ease) both;
  }

  .stage > :nth-child(2) { animation-delay: 0.06s; }
  .stage > :nth-child(3) { animation-delay: 0.12s; }
  .stage > :nth-child(4) { animation-delay: 0.18s; }
  .stage > :nth-child(5) { animation-delay: 0.24s; }
  .stage > :nth-child(6) { animation-delay: 0.3s; }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  .icon {
    display: block;
    width: clamp(72px, 9vw, 96px);
    filter: drop-shadow(0 16px 28px rgb(0 0 0 / 0.55));
  }

  .icon.sm {
    width: 64px;
    margin-inline: auto;
  }

  .icon :global(svg) {
    width: 100%;
    height: auto;
  }

  .soon {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 32px;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--ink-2);
  }

  .soon i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--orange);
    animation: breathe 2.4s ease-in-out infinite;
  }

  @keyframes breathe {
    50% { opacity: 0.3; }
  }

  h1 {
    margin-top: 10px;
    font-size: clamp(3.5rem, 8vw, 5.75rem);
    line-height: 0.95;
    font-weight: 650;
    letter-spacing: -0.045em;
  }

  .tagline {
    margin-top: 18px;
    max-width: 22ch;
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    line-height: 1.25;
    font-weight: 450;
    letter-spacing: -0.015em;
    color: var(--ink-2);
    text-wrap: balance;
  }

  .meta {
    margin-top: 14px;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }

  /* Aonin's pill button: the one primary action, in orange */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 34px;
    height: 40px;
    padding: 0 20px 0 14px;
    border-radius: 20px;
    background: var(--orange);
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: background 120ms var(--ease), transform 200ms var(--ease);
  }

  .btn svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .btn:hover {
    background: var(--orange-ink);
    transform: translateY(-1px);
  }

  .btn:active {
    transform: none;
  }

  /* The window, with the tray popover over its right side, fading into the dark below */
  .preview {
    position: relative;
    width: min(1040px, 100%);
    margin: clamp(56px, 8vw, 88px) 0 0;
    padding-right: 6%;
    -webkit-mask-image: linear-gradient(180deg, #000 45%, rgb(0 0 0 / 0.5) 72%, transparent 96%);
    mask-image: linear-gradient(180deg, #000 45%, rgb(0 0 0 / 0.5) 72%, transparent 96%);
    animation: surface 1.3s var(--ease) 0.35s both;
  }

  /* One owner for each rounded corner: the frame clips, and its edge is drawn on top at
     the same radius, so no sliver of a second curve shows at the corners. */
  .win,
  .pop {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.9);
  }

  .win::after,
  .pop::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px #3a3a3a;
    pointer-events: none;
  }

  .pop {
    position: absolute;
    right: 0;
    top: 25%;
    width: 33%;
    border-radius: 10px;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.04) inset,
      0 30px 60px -12px rgb(0 0 0 / 0.85),
      0 0 0 1px rgb(0 0 0 / 0.5);
    animation: pop 1.1s var(--ease) 0.9s both;
  }

  @keyframes surface {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.98);
    }
  }

  /* ---------- Sections (centered column, left-aligned text) ---------- */
  main {
    flex: 1;
  }

  .wrap {
    width: min(1080px, 100% - 40px);
    margin-inline: auto;
  }

  .sec {
    padding-top: clamp(88px, 12vw, 152px);
  }

  .sec:first-child {
    padding-top: clamp(40px, 6vw, 72px);
  }

  .head {
    max-width: 720px;
    margin-bottom: clamp(32px, 4vw, 48px);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--orange);
  }

  .head h2,
  .end h2 {
    margin-top: 14px;
    font-size: clamp(2rem, 4.2vw, 3rem);
    line-height: 1.04;
    font-weight: 650;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .lede {
    margin-top: 18px;
    max-width: 56ch;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .flowcard {
    padding: clamp(20px, 3.5vw, 40px);
    border-radius: 20px;
    background: var(--card);
    border: 1px solid var(--card-line);
  }

  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 40px;
    padding: 0;
  }

  .steps .num {
    display: block;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }

  .steps h3,
  .card h3 {
    margin-top: 16px;
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .steps p,
  .card p {
    margin-top: 8px;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  /* Cards */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .grid.two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 16px;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 12px 12px 24px;
    border-radius: 18px;
    background: var(--card);
    border: 1px solid var(--card-line);
  }

  .card > h3,
  .card > p {
    padding-inline: 12px;
  }

  /* Vignette: a small recessed stage holding a real piece of the app's UI */
  .vig {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    height: 248px;
    padding: 16px;
    border-radius: 12px;
    background:
      radial-gradient(circle at 1px 1px, #262626 1px, transparent 1.3px) 0 0 / 16px 16px,
      #151515;
    border: 1px solid #1f1f1f;
    overflow: hidden;
  }

  .vig.big {
    height: auto;
    padding: clamp(16px, 3vw, 32px);
  }

  .ui {
    width: 100%;
    max-width: 340px;
    padding: 12px 14px;
    border-radius: 10px;
    background: var(--housing);
    border: 1px solid #2e2e2e;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.4), 0 10px 28px rgb(0 0 0 / 0.35);
    font-size: 13px;
    text-align: left;
  }

  .ui small {
    font-size: 11px;
    letter-spacing: 0.03em;
    color: var(--ink-2);
  }

  .ui b {
    font-weight: 600;
  }

