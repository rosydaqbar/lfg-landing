# Aonin Pro checkout (Paddle). All public values. Defaults in src/data/site.ts are the sandbox ones.
# Live: PUBLIC_PADDLE_ENV=production and the live_ client token, live price and live discount IDs.
PUBLIC_PADDLE_ENV=sandbox
PUBLIC_PADDLE_CLIENT_TOKEN=
PUBLIC_PADDLE_PRICE_ID=
# Launch discount; set to none to sell at the full price
PUBLIC_PADDLE_DISCOUNT_ID=
# Indonesia promo (INDO); set to none to turn it off
PUBLIC_PADDLE_DISCOUNT_ID_INDO=
# Set to off to show Purchase as Coming soon (until Paddle approves live)
PUBLIC_PADDLE_CHECKOUT=
