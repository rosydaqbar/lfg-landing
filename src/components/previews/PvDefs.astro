---
// Shared SVG definitions for the product scenes. Flat surfaces only: depth comes from one
// soft shadow, never from gradients.
interface Props { id: string }
const { id } = Astro.props;
---
<defs>
  <filter id={`${id}-lift`} x="-20%" y="-20%" width="140%" height="160%">
    <feDropShadow dx="0" dy="10" stdDeviation="12" flood-color="#02050d" flood-opacity="0.55" />
  </filter>
</defs>
