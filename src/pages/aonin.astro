<script>
  /* The grille meters move like live audio; now and then one hole flashes orange for a
     repaired packet, the way the real app does. */
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const meters = Array.from(document.querySelectorAll<SVGGElement>('[data-meter]'));

  if (calm) {
    document.querySelectorAll<SVGSVGElement>('.ao-flow, .ao-scene').forEach((s) => s.pauseAnimations());
  }

  if (!calm && meters.length) {
    const rows = meters.map((m) => ({
      holes: Array.from(m.querySelectorAll<SVGCircleElement>('circle')),
      base: Number(m.dataset.level ?? 0),
      level: Number(m.dataset.level ?? 0),
      muted: m.hasAttribute('data-muted'),
      seed: Math.random() * 10,
    }));

    let t = 0;
    window.setInterval(() => {
      if (document.hidden) return;
      t += 0.09;
      for (const r of rows) {
        if (r.muted) continue;
        const target = Math.max(0.05, Math.min(1, r.base + Math.sin(t * 0.9 + r.seed) * 0.18 + (Math.random() - 0.5) * 0.28));
        r.level += (target - r.level) * 0.55;
        const lit = Math.round(r.level * r.holes.length);
        r.holes.forEach((h, i) => h.classList.toggle('on', i < lit));
        if (Math.random() < 0.012 && lit > 1) {
          const h = r.holes[lit - 1];
          h.classList.add('flash');
          window.setTimeout(() => h.classList.remove('flash'), 700);
        }
      }
    }, 90);
  }
</script>

<script>
  /* Try now: point every download button at the installer for this computer, taken from
     the latest GitHub release, then thank the person and offer a Pro trial key. Anything
     we can't match (Linux, phones, an API hiccup) falls back to the releases page. */
  const REPO = 'rosydaqbar/aonin';
  const buttons = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-download]'));
  const note = document.querySelector<HTMLElement>('[data-dl-note]');
  const direct = document.querySelector<HTMLAnchorElement>('[data-dl-direct]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-thanks]');

  // Analytics (Umami). Quietly does nothing when the tracker is blocked or not loaded.
  const track = (name: string, data?: Record<string, string>) => {
    try {
      (window as unknown as { umami?: { track: (n: string, d?: object) => void } }).umami?.track(name, data);
    } catch {}
  };
  let version = '';
  let direct_ok = false;

  type Asset = { name: string; browser_download_url: string };
  type Release = { tag_name: string; html_url: string; assets: Asset[] };

  const ua = navigator.userAgent;
  const platform = (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform || navigator.platform || '';
  const touchMac = /Mac/i.test(platform) && navigator.maxTouchPoints > 1; // iPadOS reports a Mac
  const os: 'windows' | 'mac' | null = /Win/i.test(platform) || /Windows/i.test(ua)
    ? 'windows'
    : /Mac/i.test(platform) && !touchMac && !/iPhone|iPad/i.test(ua)
      ? 'mac'
      : null;

  const pick: Record<'windows' | 'mac', RegExp> = { windows: /x64-setup\.exe$/i, mac: /\.dmg$/i };
  const label = { windows: 'Windows', mac: 'macOS (Apple Silicon)' };

  const apply = (r: Release) => {
    const asset = os ? r.assets.find((a) => pick[os].test(a.name)) : undefined;
    version = r.tag_name.replace(/^v/, '');
    direct_ok = !!asset;
    if (asset) {
      buttons.forEach((b) => {
        b.href = asset.browser_download_url;
        b.removeAttribute('target');
      });
      if (direct) direct.href = asset.browser_download_url;
      if (note && os) note.textContent = `Free · ${label[os]}`;
    } else {
      buttons.forEach((b) => {
        b.href = r.html_url;
        b.target = '_blank';
        b.rel = 'noopener';
      });
      if (direct) direct.href = r.html_url;
      if (note) note.textContent = 'Free · Windows and macOS';
    }
  };

  const load = async (): Promise<Release | null> => {
    try {
      const cached = sessionStorage.getItem('aonin-release');
      if (cached) return JSON.parse(cached);
    } catch {}
    try {
      const res = await fetch(`https://api.github.com/repos/${REPO}/releases/latest`, { headers: { Accept: 'application/vnd.github+json' } });
      if (!res.ok) return null;
      const r = (await res.json()) as Release;
      const slim: Release = { tag_name: r.tag_name, html_url: r.html_url, assets: r.assets.map((a) => ({ name: a.name, browser_download_url: a.browser_download_url })) };
      try { sessionStorage.setItem('aonin-release', JSON.stringify(slim)); } catch {}
      return slim;
    } catch {
      return null;
    }
  };

  // Until the release loads, the buttons open the releases page in a new tab.
  buttons.forEach((b) => {
    b.target = '_blank';
    b.rel = 'noopener';
  });
  load().then((r) => r && apply(r));

  // The download goes ahead as a normal link; the thank-you dialog opens over the page.
  const osName = os ?? 'other';
  let discordClicked = false;
  buttons.forEach((b) => b.addEventListener('click', () => {
    track('download_click', { location: b.dataset.download || 'unknown', os: osName, version: version || 'unknown' });
    if (!direct_ok) track('download_fallback', { os: osName });
    if (dialog && !dialog.open) window.setTimeout(() => {
      dialog.showModal();
      discordClicked = false;
      track('thanks_open', { os: osName });
    }, 150);
  }));
  direct?.addEventListener('click', () => track('download_retry', { os: osName }));
  dialog?.querySelector('[data-discord]')?.addEventListener('click', () => {
    discordClicked = true;
    track('discord_click', { os: osName });
  });
  dialog?.querySelector<HTMLDetailsElement>('[data-install]')?.addEventListener('toggle', (e) => {
    if ((e.currentTarget as HTMLDetailsElement).open) track('install_help_open', { os: osName });
  });
  dialog?.addEventListener('close', () => { if (!discordClicked) track('thanks_close', { os: osName }); });
  dialog?.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

  // Pro demand before Purchase opens
  document.querySelector('[data-purchase]')?.addEventListener('click', () => track('purchase_click'));

  // Pricing actually seen (40% on screen), once per visit
  const pricing = document.getElementById('pricing');
  if (pricing && 'IntersectionObserver' in window) {
    const seen = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        track('pricing_view');
        seen.disconnect();
      }
    }, { threshold: 0.4 });
    seen.observe(pricing);
  }
</script>
